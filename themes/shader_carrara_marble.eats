# SolEngine Custom Background Theme — Carrara Marble
# Domain-warped metamorphic fluid stone with sharp calcite fracture veins & brass table inlay

sol.set_theme({
    id: "shader_carrara_marble",
    name: "Carrara Marble",
    author: "SolEngine / Eatscript",
    description: "Polished Italian white and gray Carrara marble with serpentine calcite veins",
    version: 1,
    procedural: true
})

def marble_shader(u, v, nx, ny, in_r, in_g, in_b):
    dist = hypot(nx * 0.9, ny)

    # 1. Dual Domain Warping (Fluid shear in metamorphic stone)
    qx = fbm(nx * 2.8, ny * 2.8)
    qy = fbm(nx * 2.8 + 5.2, ny * 2.8 + 1.3)

    rx = fbm(nx * 2.8 + qx * 3.5, ny * 2.8 + qy * 3.5)
    ry = fbm(nx * 2.8 + qx * 3.5 + 1.7, ny * 2.8 + qy * 3.5 + 9.2)

    field = fbm(nx * 2.8 + rx * 3.0, ny * 2.8 + ry * 3.0)

    # 2. Sharp calcite fracture veins via sin power curves
    vein_raw = abs(sin((field + nx * 0.4 - ny * 0.3) * 6.28318))
    veins = smoothstep(0.04, 0.28, vein_raw)
    fine_veins = smoothstep(0.015, 0.08, abs(sin(field * 18.84))) * 0.25

    # 3. Base marble palette (pale alabaster / pearl gray base to charcoal veins)
    albedo = 0.88 + field * 0.08 - (1.0 - veins) * 0.35 - (1.0 - fine_veins) * 0.15

    # 4. Subtle cool slate tint
    mr = albedo * 0.98
    mg = albedo * 0.99
    mb = albedo * 1.02

    # 5. Photographic vignette to soften bright edges
    vignette = smoothstep(1.4, 0.45, dist)
    grain = (random() - 0.5) * 0.015

    # Composite with vector inlay from canvas
    r = clamp(mix(mr * vignette, in_r, in_r * 0.7) + grain, 0.0, 1.0)
    g = clamp(mix(mg * vignette, in_g, in_g * 0.7) + grain, 0.0, 1.0)
    b = clamp(mix(mb * vignette, in_b, in_b * 0.7) + grain, 0.0, 1.0)
    return [r, g, b]

def on_draw_background(ctx, w, h):
    # 1. Base fill
    ctx.fill_rect(0, 0, w, h, "#e8e8ec")

    # 2. Brushed brass inlay border around table perimeter
    inset = 20.0
    ctx.stroke_rect(inset, inset, w - inset * 2.0, h - inset * 2.0, "#a89058", 2.5)
    ctx.stroke_rect(inset + 4.0, inset + 4.0, w - (inset + 4.0) * 2.0, h - (inset + 4.0) * 2.0, "#483820", 1.0)

    # 3. Run full-canvas marble shader
    ctx.apply_shader("marble_shader", intensity=1.0)

