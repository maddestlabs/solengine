# SolEngine Custom Background Theme — Cosmic Nebula
# Deep space violet & teal luminous plasma clouds, stellar dust, and multi-magnitude star clusters

sol.set_theme({
    id: "shader_cosmic_nebula",
    name: "Cosmic Nebula",
    author: "SolEngine / Eatscript",
    description: "Deep space stellar nursery with glowing violet and teal dust clouds and twinkling star clusters",
    version: 1,
    procedural: true
})

def nebula_shader(u, v, nx, ny, in_r, in_g, in_b):
    dist = hypot(nx * 0.90, ny)

    # 1. Multi-octave glowing gaseous plasma clouds
    gas1 = fbm(nx * 2.5, ny * 2.5)
    gas2 = fbm(nx * 4.5 + 2.3, ny * 4.5 + 5.1)
    gas3 = fbm(nx * 8.0 - 1.7, ny * 8.0 + 3.4)

    # Violet/Magenta plasma arm
    arm1 = pow(clamp(gas1 * 0.7 + gas2 * 0.5, 0.0, 1.0), 2.2)

    # Cyan/Teal plasma filament
    arm2 = pow(clamp(gas2 * 0.6 + gas3 * 0.6, 0.0, 1.0), 2.5)

    # 2. Twinkling star field via high-frequency thresholded noise
    star_noise = fbm(nx * 45.0, ny * 45.0)
    stars = pow(clamp((star_noise - 0.72) * 4.5, 0.0, 1.0), 4.0)

    # 3. Celestial palette synthesis
    base_r = 0.03 + arm1 * 0.45 + arm2 * 0.08 + stars * 0.85
    base_g = 0.03 + arm1 * 0.12 + arm2 * 0.38 + stars * 0.90
    base_b = 0.07 + arm1 * 0.55 + arm2 * 0.52 + stars * 1.00

    # 4. Deep space optical falloff
    vignette = smoothstep(1.4, 0.40, dist)
    grain = (random() - 0.5) * 0.02

    r = clamp(base_r * vignette + grain, 0.0, 1.0)
    g = clamp(base_g * vignette + grain, 0.0, 1.0)
    b = clamp(base_b * vignette + grain, 0.0, 1.0)
    return [r, g, b]

def on_draw_background(ctx, w, h):
    # 1. Base void black
    ctx.fill_rect(0, 0, w, h, "#05060d")

    # 2. Electric neon perimeter constellation boundary
    inset = 18.0
    ctx.stroke_rect(inset, inset, w - inset * 2.0, h - inset * 2.0, "#3c4878", 1.5)

    # 3. Run cosmic nebula shader
    ctx.apply_shader("nebula_shader", intensity=1.0)

