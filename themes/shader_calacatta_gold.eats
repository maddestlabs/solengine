# SolEngine Custom Background Theme — Calacatta Gold
# Warm Tuscan ivory stone with sweeping honey, amber, and bronze calcite fracture veins & antique gold table inlay

sol.set_theme({
    id: "shader_calacatta_gold",
    name: "Calacatta Gold",
    author: "SolEngine / Eatscript",
    description: "Warm ivory Tuscan marble with sweeping honey, amber, and bronze veins",
    version: 1,
    procedural: true
})

def calacatta_shader(u, v, nx, ny, in_r, in_g, in_b):
    dist = hypot(nx * 0.9, ny)

    # 1. Dual Domain Warping (Sweeping fluid metamorphic shear)
    qx = fbm(nx * 2.4, ny * 2.4)
    qy = fbm(nx * 2.4 + 4.8, ny * 2.4 + 1.6)

    rx = fbm(nx * 2.4 + qx * 3.2, ny * 2.4 + qy * 3.2)
    ry = fbm(nx * 2.4 + qx * 3.2 + 2.1, ny * 2.4 + qy * 3.2 + 8.4)

    field = fbm(nx * 2.4 + rx * 2.8, ny * 2.4 + ry * 2.8)

    # 2. Calcite and breccia fracture veins
    vein_raw = abs(sin((field + nx * 0.35 - ny * 0.25) * 5.5))
    veins = smoothstep(0.05, 0.30, vein_raw)
    fine_veins = smoothstep(0.015, 0.08, abs(sin(field * 16.0))) * 0.25

    # 3. Base warm ivory stone palette (albedo ~0.72, gentle warm cream without harsh white glare)
    luma = 0.72 + field * 0.07
    vein_factor = 1.0 - veins
    fine_factor = 1.0 - fine_veins

    # Base stone: warm ecru / biscuit alabaster
    base_r = luma * 1.03
    base_g = luma * 0.98
    base_b = luma * 0.88

    # Vein tone: rich amber / bronze-umber
    vein_r = 0.44 + field * 0.10
    vein_g = 0.32 + field * 0.08
    vein_b = 0.18 + field * 0.05

    # Blend stone with amber veins and subtle fine fissures
    mr = mix(base_r, vein_r, vein_factor * 0.65 + fine_factor * 0.35)
    mg = mix(base_g, vein_g, vein_factor * 0.65 + fine_factor * 0.35)
    mb = mix(base_b, vein_b, vein_factor * 0.65 + fine_factor * 0.35)

    # 4. Photographic vignette to soften perimeter
    vignette = smoothstep(1.4, 0.45, dist)
    grain = (random() - 0.5) * 0.015

    # Composite with vector inlay from canvas
    r = clamp(mix(mr * vignette, in_r, in_r * 0.7) + grain, 0.0, 1.0)
    g = clamp(mix(mg * vignette, in_g, in_g * 0.7) + grain, 0.0, 1.0)
    b = clamp(mix(mb * vignette, in_b, in_b * 0.7) + grain, 0.0, 1.0)
    return [r, g, b]

def on_draw_background(ctx, w, h):
    # 1. Warm ivory base fill
    ctx.fill_rect(0, 0, w, h, "#dcd5c4")

    # 2. Florentine burnished antique gold inlay border
    inset = 20.0
    ctx.stroke_rect(inset, inset, w - inset * 2.0, h - inset * 2.0, "#bfa052", 2.5)
    ctx.stroke_rect(inset + 4.0, inset + 4.0, w - (inset + 4.0) * 2.0, h - (inset + 4.0) * 2.0, "#4e3816", 1.0)

    # 3. Run full-canvas marble shader
    ctx.apply_shader("calacatta_shader", intensity=1.0)

