# SolEngine Procedural Background Theme — Brushed Chrome
# Pure Eatscript Bytecode Shader: Grayscale anisotropic 6-octave brushed metal core (no baked lighting)

sol.set_theme({
    id: "brushed_chrome",
    name: "Brushed Chrome",
    author: "Maddest Labs",
    description: "Anisotropic brushed chrome and metallic alloy grain tuned for dynamic surface lighting",
    version: 1,
    procedural: true,
    lacquer: 0.92,
    relief_bump: 1.6,
    option_label: "Alloy",
    options: [
        { id: "polished_chrome", name: "Polished Chrome", u: [0.84, 0.86, 0.89, 1.0] },
        { id: "brushed_nickel",  name: "Brushed Nickel",  u: [0.78, 0.76, 0.71, 1.0] },
        { id: "titanium_steel",  name: "Titanium Steel",  u: [0.60, 0.64, 0.69, 1.0] },
        { id: "gunmetal",        name: "Gunmetal",        u: [0.36, 0.38, 0.42, 1.0] },
        { id: "cobalt_chrome",   name: "Cobalt Chrome",   u: [0.58, 0.68, 0.82, 1.0] }
    ]
})

def brushed_chrome_shader(u, v, nx, ny, in_r, in_g, in_b, px, py):
    dist = hypot(nx * 0.95, ny)

    # 1. Anisotropic 6-octave hash noise (unrolled for Eatscript shader VM)
    ux = px * 0.000000001
    vy = v

    n0 = fract(sin((ux * 12.9898 + vy * 78.233) * 1.0) * 43758.5453) * 1.0
    ux = ux * 8.0
    n1 = fract(sin((ux * 12.9898 + vy * 78.233) * 2.0) * 43758.5453) * 0.5
    ux = ux * 8.0
    n2 = fract(sin((ux * 12.9898 + vy * 78.233) * 3.0) * 43758.5453) * 0.25
    ux = ux * 8.0
    n3 = fract(sin((ux * 12.9898 + vy * 78.233) * 4.0) * 43758.5453) * 0.125
    ux = ux * 8.0
    n4 = fract(sin((ux * 12.9898 + vy * 78.233) * 5.0) * 43758.5453) * 0.0625
    ux = ux * 8.0
    n5 = fract(sin((ux * 12.9898 + vy * 78.233) * 6.0) * 43758.5453) * 0.03125

    noise = n0 + n1 + n2 + n3 + n4 + n5

    # 2. Blend fine white noise and remap core brushed metal density
    white_noise = fract(sin(px * 12.9898 + py * 78.233) * 43758.5453)
    blended_noise = mix(noise, noise - 0.5 * white_noise, 0.5)
    blended_noise = blended_noise * 0.15 + 0.25

    # 3. Grayscale metallic luminance modulated by alloy tint via uniforms
    metal_tone = blended_noise * 1.35

    ur = mix(0.84, u0, u3)
    ug = mix(0.86, u1, u3)
    ub = mix(0.89, u2, u3)

    base_r = ur * metal_tone
    base_g = ug * metal_tone
    base_b = ub * metal_tone

    # 4. Subtle vignette falloff
    vignette = smoothstep(3.0, 0.25, dist)

    r = clamp(base_r * vignette, 0.0, 1.0)
    g = clamp(base_g * vignette, 0.0, 1.0)
    b = clamp(base_b * vignette, 0.0, 1.0)
    return [r, g, b]

def on_draw_background(ctx, w, h):
    ur = mix(0.30, u0 * 0.36, u3)
    ug = mix(0.31, u1 * 0.36, u3)
    ub = mix(0.33, u2 * 0.36, u3)
    ctx.fill_rect(0, 0, w, h, [ur, ug, ub])
    inset = 18.0
    ctx.stroke_rect(inset, inset, w - inset * 2.0, h - inset * 2.0, [ur * 1.4, ug * 1.4, ub * 1.4], 1.8)
    ctx.apply_shader("brushed_chrome_shader", intensity=1.0)
