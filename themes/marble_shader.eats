# SolEngine Procedural Background Theme — Marble Countertop (Shader Recolor + 4-Color Macro Gradient)
# 1. Single 42.4 KB 512x512 seamless mineral map (q=32 JPEG) supplies crisp stone structure
# 2. Eatscript 3-stop recolor shader cleans compression artifacts across all 8 stone palettes
# 3. Viewport-wide 4-corner geological gradient (with gentle FBM drift) breaks up tile repetition

sol.set_theme({
    id: "marble_shader",
    name: "Marble (Shader)",
    author: "Maddest Labs",
    description: "Marble countertop slabs: 42 KB 512x512 mineral map + shader recoloring + 4-color macro gradient",
    version: 2,
    procedural: true,
    lacquer: 0.65,
    relief_bump: 0.0,
    option_label: "Stone",
    options: [
        { id: "carrara",         name: "Bianco Carrara",  u: [0.88, 0.88, 0.88, -0.5] },
        { id: "calacatta_gold",  name: "Calacatta Gold",  u: [0.89, 0.89, 0.88, -1.0] },
        { id: "nero_marquina",   name: "Nero Marquina",   u: [0.12, 0.12, 0.13,  1.0] },
        { id: "emperador_dark",  name: "Emperador Dark",  u: [0.22, 0.16, 0.11,  0.6] },
        { id: "verde_alpi",      name: "Verde Alpi",      u: [0.09, 0.15, 0.11,  0.8] },
        { id: "rosa_portogallo", name: "Rosa Portogallo", u: [0.92, 0.82, 0.77, -0.7] },
        { id: "rosso_levanto",   name: "Rosso Levanto",   u: [0.31, 0.12, 0.12,  1.0] },
        { id: "giallo_siena",    name: "Giallo Siena",    u: [0.42, 0.28, 0.17,  0.7] }
    ]
})

def marble_recolor_shader(u, v, nx, ny, in_r, in_g, in_b):
    # Scalar mineral value [0..1]: pre-thresholded at 0.14 before JPEG encode;
    # 0.06 floor suppresses any residual JPEG ringing around 0
    s = in_r
    t_halo = smoothstep(0.06, 0.62, s)
    t_vein = smoothstep(0.50, 0.94, s)

    # Vein target derived from u3 polarity:
    # u3 > 0: bright calcite/cream veins; u3 < 0: darker slate/taupe/gold veins on light stone
    is_light = step(u3, 0.0)
    vr = mix(mix(0.84, 0.90, clamp(u3, 0.0, 1.0)), mix(0.58, 0.38, clamp(-u3, 0.0, 1.0)), is_light)
    vg = mix(mix(0.75, 0.88, clamp(u3, 0.0, 1.0)), mix(0.58, 0.35, clamp(-u3, 0.0, 1.0)), is_light)
    vb = mix(mix(0.65, 0.86, clamp(u3, 0.0, 1.0)), mix(0.59, 0.31, clamp(-u3, 0.0, 1.0)), is_light)

    # Mid-tone halo slightly warmer/shaded between matrix (u0,u1,u2) and vein (vr,vg,vb)
    hr = mix(u0, vr, 0.42) * 0.94
    hg = mix(u1, vg, 0.40) * 0.92
    hb = mix(u2, vb, 0.38) * 0.90

    r = mix(mix(u0, hr, t_halo), vr, t_vein)
    g = mix(mix(u1, hg, t_halo), vg, t_vein)
    b = mix(mix(u2, hb, t_halo), vb, t_vein)

    # Viewport-wide 4-color geological gradient with organic FBM drift (breaks up 512px tile repeat)
    gu = clamp(u + (fbm(nx * 1.4 + 2.1, ny * 1.4 + 4.3, 2) - 0.5) * 0.38, 0.0, 1.0)
    gv = clamp(v + (fbm(nx * 1.4 + 7.7, ny * 1.4 + 1.9, 2) - 0.5) * 0.38, 0.0, 1.0)

    # 4 corner tonal shifts anchored to the stone's own matrix & vein palette:
    # TL: warm earthy mineral | TR: cool slate/mineral | BL: deep shadow zone | BR: luminous calcite cloud
    c_tl_r = mix(u0, vr, 0.24) * 1.14
    c_tl_g = mix(u1, vg, 0.18) * 1.04
    c_tl_b = mix(u2, vb, 0.08) * 0.86

    c_tr_r = mix(u0, vr, 0.08) * 0.86
    c_tr_g = mix(u1, vg, 0.16) * 1.00
    c_tr_b = mix(u2, vb, 0.26) * 1.16

    c_bl_r = u0 * 0.72
    c_bl_g = u1 * 0.72
    c_bl_b = u2 * 0.74

    c_br_r = mix(u0, vr, 0.34) * 1.16
    c_br_g = mix(u1, vg, 0.34) * 1.14
    c_br_b = mix(u2, vb, 0.34) * 1.12

    gr = mix(mix(c_tl_r, c_tr_r, gu), mix(c_bl_r, c_br_r, gu), gv)
    gg = mix(mix(c_tl_g, c_tr_g, gu), mix(c_bl_g, c_br_g, gu), gv)
    gb = mix(mix(c_tl_b, c_tr_b, gu), mix(c_bl_b, c_br_b, gu), gv)

    # Apply stronger macro zoning across matrix/halo while keeping crisp veins clear
    gw = 0.42 * (1.0 - t_vein * 0.55)
    r = clamp(mix(r, gr, gw), 0.0, 1.0)
    g = clamp(mix(g, gg, gw), 0.0, 1.0)
    b = clamp(mix(b, gb, gw), 0.0, 1.0)

    # Soft elliptical edge vignette + increased contrast toward the edges
    d_vig = hypot((u - 0.5) * 1.35, (v - 0.5) * 1.35)
    edge_t = smoothstep(0.38, 1.05, d_vig)
    vig = 1.0 - edge_t * 0.24
    c_boost = 1.0 + edge_t * 0.55
    r = clamp((r - mix(u0 * 1.15, u0 * 0.85, is_light)) * c_boost + mix(u0 * 1.15, u0 * 0.85, is_light), 0.0, 1.0) * vig
    g = clamp((g - mix(u1 * 1.15, u1 * 0.85, is_light)) * c_boost + mix(u1 * 1.15, u1 * 0.85, is_light), 0.0, 1.0) * vig
    b = clamp((b - mix(u2 * 1.15, u2 * 0.85, is_light)) * c_boost + mix(u2 * 1.15, u2 * 0.85, is_light), 0.0, 1.0) * vig
    return [r, g, b]

def on_draw_background(ctx, w, h):
    ctx.apply_gradient_lut("marble/rosso_levanto_mineral_low.jpg", "marble/identity_lut.png", 0.020, true, 512.0)
    ctx.apply_shader("marble_recolor_shader", intensity=1.0)
