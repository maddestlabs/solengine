# ==============================================================================
# SolEngine Procedural Ambience: Torchlit Dungeon (.eats)
# Enclosed stone vault rumble, drafty corridor air, nearby wall-sconce torch
# crackles, distant damp masonry water drips, and occasional loose stone grit.
# ==============================================================================

sol.define_ambience({
    id: "torchlit_dungeon",
    name: "Torchlit Dungeon",
    master_gain: 1.0,
    layers: [
        # 1. Deep enclosed stone-vault rumble
        {
            type: "noise_bed",
            color: "brown",
            filter: "lowpass",
            cutoff: 155.0,
            q: 0.707,
            gain: 0.34,
            lfo_rate: 0.08,
            lfo_depth: 30.0,
            amp_mod: 0.10
        },
        # 2. Gentle drafty corridor air
        {
            type: "noise_bed",
            color: "pink",
            filter: "bandpass",
            cutoff: 360.0,
            q: 1.45,
            gain: 0.14,
            lfo_rate: 0.07,
            lfo_depth: 110.0,
            amp_mod: 0.28
        },
        # 3. Wall-sconce torch ember crackles (tighter stereo than open campfire)
        {
            type: "stochastic_grains",
            rate: 9.5,
            freq_min: 1900.0,
            freq_max: 6400.0,
            decay: 0.0065,
            q: 2.3,
            gain: 0.36,
            stereo_spread: 0.32
        },
        # 4. Warm torch flame flutter & resin pops
        {
            type: "stochastic_grains",
            rate: 2.0,
            freq_min: 240.0,
            freq_max: 580.0,
            decay: 0.024,
            q: 2.2,
            gain: 0.24,
            stereo_spread: 0.28
        },
        # 5. Distant damp masonry water drips (high-Q resonant plinks, Deep Vault style)
        {
            type: "stochastic_grains",
            rate: 0.30,
            freq_min: 1800.0,
            freq_max: 4200.0,
            decay: 0.055,
            q: 14.0,
            gain: 0.18,
            stereo_spread: 0.85
        },
        # 6. Sparse loose stone grit & settling dust
        {
            type: "stochastic_grains",
            rate: 0.18,
            freq_min: 1600.0,
            freq_max: 3800.0,
            decay: 0.045,
            q: 1.4,
            gain: 0.11,
            stereo_spread: 0.80
        }
    ]
})
