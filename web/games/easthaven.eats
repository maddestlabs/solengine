# =============================================================================
# SolEngine Game Variant: Easthaven (.eats)
# =============================================================================
# A fast-paced fusion of Klondike tableau rules with Spider-style stock deals.

name = "Easthaven"
family = "Klondike"
category = "KLONDIKE"
layout = "columns"
description = "Klondike mechanics with Spider stock deals. Tap stock to deal one card to all 7 columns."
decks = 1
tableaus = 7
foundations = 4
freecells = 0

tableau_deal_counts = [3, 3, 3, 3, 3, 3, 3]
tableau_all_face_up = False
foundation_starter_card = False

stock_deal_mode = "deal_to_all_columns"
stock_deal_count = 7
max_redeals = 0
demo_seed = 8

# --- Unified Help & Introspection Manifest ---
doc_meta(2, "Quick", 3, "Moderate", 3, "Tactical")
doc_aliases(["Easthaven Klondike"])
doc_goal("Build all 4 Foundations up in suit from Ace to King.", "No legal moves remain.")
doc_zone(0, "Stock", "Click to deal 1 face-up card onto each of the 7 Tableau columns.")
doc_zone(2, "Foundations (1-4)", "Build up by same suit from Ace to King.", ["AS", "2S", "3S"])
doc_zone(6, "Tableau Columns (1-7)", "Build down in alternating colors; ordered runs move together; Kings fill empty columns.", ["KH", "QS", "JD"])

def eval_heuristic():
    score = 0
    z = 2
    while z <= 5:
        score = score + zone_size(z) * 120
        z = z + 1
    z = 6
    while z <= 12:
        sz = zone_size(z)
        i = 0
        while i < sz:
            if not card_face_up(z, i):
                score = score - 25
            i = i + 1
        z = z + 1
    return score

def can_pick(z, i):
    sz = zone_size(z)
    if z < 6 or z > 12 or sz == 0 or i < 0 or i >= sz:
        return False
    if not card_face_up(z, i):
        return False
    k = i
    while k < sz - 1:
        if card_is_red(z, k) == card_is_red(z, k + 1) or card_rank(z, k) != card_rank(z, k + 1) + 1:
            return False
        k = k + 1
    return True

def can_drop(from_z, i, to_z):
    if from_z == to_z or zone_size(from_z) == 0:
        return False
    sz = zone_size(from_z)
    r = card_rank(from_z, i)
    s = card_suit(from_z, i)
    red = card_is_red(from_z, i)

    if to_z >= 2 and to_z <= 5:
        if i != sz - 1:
            return False
        fsz = zone_size(to_z)
        if fsz == 0:
            return r == 1
        return card_suit(to_z, fsz - 1) == s and r == card_rank(to_z, fsz - 1) + 1

    if to_z >= 6 and to_z <= 12:
        tsz = zone_size(to_z)
        if tsz == 0:
            return r == 13
        return (card_is_red(to_z, tsz - 1) != red) and (card_rank(to_z, tsz - 1) == r + 1)

    return False

def on_stock_click():
    if zone_size(0) == 0:
        return False
    col = 6
    while col <= 12 and zone_size(0) > 0:
        top = zone_size(0) - 1
        move_cards(0, top, col)
        flip_card(col, zone_size(col) - 1, True)
        col = col + 1
    return True

def on_turn_end():
    z = 6
    while z <= 12:
        sz = zone_size(z)
        if sz > 0 and not card_face_up(z, sz - 1):
            flip_card(z, sz - 1, True)
        z = z + 1
    return True

def get_status():
    total = zone_size(2) + zone_size(3) + zone_size(4) + zone_size(5)
    if total == 52:
        return "victory"
    return "playing"
