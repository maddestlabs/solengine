# =============================================================================
# SolEngine Game Family: Klondike (.eats)
# Consolidated variants: Klondike (Draw 1), Klondike (Draw 3), Easthaven
# =============================================================================

# --- Shared Klondike Rules ---

def klondike_eval():
    score = 0
    z = 2
    while z <= 5:
        score = score + zone_size(z) * 120
        z = z + 1
    z = 6
    while z <= 12:
        sz = zone_size(z)
        i = 0
        while i < sz:
            if not card_face_up(z, i):
                score = score - 25
            i = i + 1
        z = z + 1
    return score

def klondike_can_pick(z, i):
    sz = zone_size(z)
    if sz == 0 or i < 0 or i >= sz:
        return False
    if z == 1:
        return i == sz - 1
    if z >= 6 and z <= 12:
        return card_face_up(z, i)
    return False

def easthaven_can_pick(z, i):
    sz = zone_size(z)
    if z < 6 or z > 12 or sz == 0 or i < 0 or i >= sz:
        return False
    if not card_face_up(z, i):
        return False
    k = i
    while k < sz - 1:
        if card_is_red(z, k) == card_is_red(z, k + 1) or card_rank(z, k) != card_rank(z, k + 1) + 1:
            return False
        k = k + 1
    return True

def klondike_can_drop(from_z, i, to_z):
    if from_z == to_z or zone_size(from_z) == 0:
        return False
    sz = zone_size(from_z)
    r = card_rank(from_z, i)
    s = card_suit(from_z, i)
    red = card_is_red(from_z, i)

    if to_z >= 2 and to_z <= 5:
        if i != sz - 1:
            return False
        fsz = zone_size(to_z)
        if fsz == 0:
            return r == 1
        return card_suit(to_z, fsz - 1) == s and r == card_rank(to_z, fsz - 1) + 1

    if to_z >= 6 and to_z <= 12:
        tsz = zone_size(to_z)
        if tsz == 0:
            return r == 13
        return card_face_up(to_z, tsz - 1) and (card_is_red(to_z, tsz - 1) != red) and (card_rank(to_z, tsz - 1) == r + 1)

    return False

def klondike_draw_stock(count):
    if zone_size(0) > 0:
        k = 0
        while k < count and zone_size(0) > 0:
            top = zone_size(0) - 1
            move_cards(0, top, 1)
            flip_card(1, zone_size(1) - 1, True)
            k = k + 1
        return True
    if zone_size(1) > 0:
        while zone_size(1) > 0:
            top = zone_size(1) - 1
            move_cards(1, top, 0)
            flip_card(0, zone_size(0) - 1, False)
        return True
    return False

def k1_stock():
    return klondike_draw_stock(1)

def k3_stock():
    return klondike_draw_stock(3)

def easthaven_stock():
    if zone_size(0) == 0:
        return False
    col = 6
    while col <= 12 and zone_size(0) > 0:
        top = zone_size(0) - 1
        move_cards(0, top, col)
        flip_card(col, zone_size(col) - 1, True)
        col = col + 1
    return True

def klondike_on_turn_end():
    z = 6
    while z <= 12:
        sz = zone_size(z)
        if sz > 0 and not card_face_up(z, sz - 1):
            flip_card(z, sz - 1, True)
        z = z + 1
    return True

def klondike_status():
    total = zone_size(2) + zone_size(3) + zone_size(4) + zone_size(5)
    if total == 52:
        return "victory"
    return "playing"

