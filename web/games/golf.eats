# =============================================================================
# SolEngine Game Family: Golf (.eats)
# Consolidated variants: Golf, TriPeaks, Clockwork Dial, Black Hole
# =============================================================================

# --- Shared Parameterized Golf Rules ---

def golf_eval(t_start, t_end, total_cards, stock_z):
    rem = 0
    z = t_start
    while z <= t_end:
        rem = rem + zone_size(z)
        z = z + 1
    return (total_cards - rem) * 100 + zone_size(stock_z) * 10

def golf_on_deal(stock_z, found_z):
    if zone_size(found_z) == 0 and zone_size(stock_z) > 0:
        top = zone_size(stock_z) - 1
        move_cards(stock_z, top, found_z)
        flip_card(found_z, 0, True)
    return True

def golf_can_pick(t_start, t_end, check_face_up, check_blocked, z, i):
    sz = zone_size(z)
    if z < t_start or z > t_end or sz == 0 or i != sz - 1:
        return False
    if check_face_up and not card_face_up(z, i):
        return False
    if check_blocked and is_card_blocked(z, i):
        return False
    return True

def golf_can_drop(t_start, t_end, found_z, wrap_king_ace, allow_on_king, check_face_up, check_blocked, from_z, i, to_z):
    if to_z != found_z or from_z < t_start or from_z > t_end:
        return False
    if not golf_can_pick(t_start, t_end, check_face_up, check_blocked, from_z, i):
        return False
    fsz = zone_size(found_z)
    if fsz == 0:
        return True
    fr = card_rank(found_z, fsz - 1)
    if not allow_on_king and fr == 13:
        return False
    mr = card_rank(from_z, i)
    if mr == fr + 1 or mr == fr - 1:
        return True
    if wrap_king_ace and ((fr == 13 and mr == 1) or (fr == 1 and mr == 13)):
        return True
    return False

def golf_on_stock(stock_z, found_z):
    if zone_size(stock_z) == 0:
        return False
    top = zone_size(stock_z) - 1
    move_cards(stock_z, top, found_z)
    flip_card(found_z, zone_size(found_z) - 1, True)
    return True

def golf_status(t_start, t_end):
    rem = 0
    z = t_start
    while z <= t_end:
        rem = rem + zone_size(z)
        z = z + 1
    if rem == 0:
        return "victory"
    return "playing"

# --- Golf (7-Column Classic) Bindings ---
def g_eval():
    return golf_eval(2, 8, 35, 0)

def g_deal():
    return golf_on_deal(0, 1)

def g_pick(z, i):
    return golf_can_pick(2, 8, False, False, z, i)

def g_drop(from_z, i, to_z):
    return golf_can_drop(2, 8, 1, False, False, False, False, from_z, i, to_z)

def g_click(z, i):
    if not g_drop(z, i, 1):
        return False
    move_cards(z, i, 1)
    add_score(10)
    return True

def g_stock():
    return golf_on_stock(0, 1)

def g_status():
    return golf_status(2, 8)

# --- TriPeaks Bindings ---
def tp_eval():
    return golf_eval(2, 29, 28, 0)

def tp_deal():
    return golf_on_deal(0, 1)

def tp_pick(z, i):
    return golf_can_pick(2, 29, True, True, z, i)

def tp_drop(from_z, i, to_z):
    return golf_can_drop(2, 29, 1, True, True, True, True, from_z, i, to_z)

def tp_click(z, i):
    if not tp_drop(z, i, 1):
        return False
    move_cards(z, i, 1)
    add_score(10)
    return True

def tp_stock():
    return golf_on_stock(0, 1)

def tp_turn_end():
    z = 2
    while z <= 29:
        sz = zone_size(z)
        if sz > 0 and not card_face_up(z, sz - 1) and not is_card_blocked(z, sz - 1):
            flip_card(z, sz - 1, True)
        z = z + 1
    return True

def tp_status():
    return golf_status(2, 29)

# --- Clockwork Dial Bindings ---
def cd_eval():
    rem = 0
    z = 0
    while z <= 11:
        rem = rem + zone_size(z)
        z = z + 1
    return (36 - rem) * 100 + zone_size(13) * 15

def cd_deal():
    return golf_on_deal(13, 12)

def cd_pick(z, i):
    return golf_can_pick(0, 11, True, False, z, i)

def cd_drop(from_z, i, to_z):
    return golf_can_drop(0, 11, 12, True, True, True, False, from_z, i, to_z)

def cd_click(z, i):
    if not cd_drop(z, i, 12):
        return False
    move_cards(z, i, 12)
    add_score(10)
    return True

def cd_stock():
    return golf_on_stock(13, 12)

def cd_turn_end():
    z = 0
    while z <= 11:
        sz = zone_size(z)
        if sz > 0 and not card_face_up(z, sz - 1):
            flip_card(z, sz - 1, True)
        z = z + 1
    return True

def cd_status():
    return golf_status(0, 11)

# --- Black Hole Bindings ---
# Zones 0..6   = Inner Ring (7 fans of 3 cards, all face-up)
# Zones 7..16  = Outer Ring (10 fans of 3 cards, all face-up)
# Zone  17     = Center Black Hole Foundation (starts with Ace of Spades)

def bh_eval():
    rem = 0
    deep_pen = 0
    z = 0
    while z <= 16:
        sz = zone_size(z)
        rem = rem + sz
        if sz > 1:
            deep_pen = deep_pen + sz * sz * 12
        z = z + 1
    return (51 - rem) * 200 - deep_pen

def bh_deal():
    # Ensure the Ace of Spades (suit 0, rank 1) starts in the center Black Hole (zone 17).
    if zone_size(17) > 0 and card_suit(17, 0) == 0 and card_rank(17, 0) == 1:
        return True
    z = 0
    while z <= 16:
        sz = zone_size(z)
        i = 0
        while i < sz:
            if card_suit(z, i) == 0 and card_rank(z, i) == 1:
                if i < sz - 1:
                    move_cards(z, i + 1, 17)
                move_cards_bottom(z, i, 17)
                move_cards(17, 1, z)
                return True
            i = i + 1
        z = z + 1
    return True

def bh_pick(z, i):
    return golf_can_pick(0, 16, True, False, z, i)

def bh_drop(from_z, i, to_z):
    return golf_can_drop(0, 16, 17, True, True, True, False, from_z, i, to_z)

def bh_click(z, i):
    if not bh_drop(z, i, 17):
        return False
    move_cards(z, i, 17)
    add_score(10)
    return True

def bh_status():
    return golf_status(0, 16)

def bh_victory():
    victory_clear_stages()
    victory_add_stage("spiral_vortex")
    return True

def bh_layout(bw, bh):
    pad_top = max(14.0, get_safe_top() + 10.0)
    pad_bot = max(44.0, get_safe_bottom() + 40.0)
    pad_x = max(14.0, max(get_safe_left(), get_safe_right()) + 12.0)
    avail_w = max(200.0, bw - 2.0 * pad_x)
    avail_h = max(200.0, bh - pad_top - pad_bot)

    cx = bw * 0.5
    cy = pad_top + avail_h * 0.5

    # Responsive ellipticity: circular in portrait/square, gently elliptical on widescreen
    ar = avail_w / avail_h
    ellip_x = 1.0
    if ar > 1.05:
        ellip_x = min(1.38, 1.0 + (ar - 1.0) * 0.48)

    # Dual-ring radial geometry in units of card height (ch):
    # Inner ring (7 fans) base at 1.24*ch, outer ring (10 fans) base at 2.62*ch,
    # 3-card outward fan step = 0.16*ch (2 steps = 0.32*ch), half-card = 0.50*ch.
    r_in_u = 1.24
    r_out_u = 2.62
    fan_u = 0.16
    tip_u = 2.0 * fan_u + 0.50

    ch_from_h = avail_h / (2.0 * (r_out_u + tip_u))
    ch_from_w = avail_w / (2.0 * (r_out_u * ellip_x + tip_u))
    ch_target = min(ch_from_h, ch_from_w)
    cw_target = ch_target / 1.40

    set_card_size(cw_target)
    cw = get_card_width()
    ch = get_card_height()

    r_in_y = r_in_u * ch
    r_in_x = r_in_y * ellip_x
    r_out_y = r_out_u * ch
    r_out_x = r_out_y * ellip_x
    fan_step = fan_u * ch

    # Center Black Hole (zone 17): upright Ace of Spades
    set_zone_pose(17, cx - cw * 0.5, cy - ch * 0.5, 0.0, 20)
    set_zone_fan(17, 0.0, 0.0)

    pi = 3.14159265
    rad_to_deg = 180.0 / pi

    # Inner ring: 7 fans (zones 0..6), clockwise from 12 o'clock
    i = 0
    while i < 7:
        theta = -pi * 0.5 + i * (2.0 * pi / 7.0)
        vx = r_in_x * cos(theta)
        vy = r_in_y * sin(theta)
        dist = max(1.0, sqrt(vx * vx + vy * vy))
        ux = vx / dist
        uy = vy / dist
        ang = atan2(vy, vx) * rad_to_deg + 90.0
        px = cx + vx - cw * 0.5
        py = cy + vy - ch * 0.5
        set_zone_pose(i, px, py, ang, i)
        set_zone_fan(i, ux, uy)
        set_zone_fan_step(i, fan_step)
        i = i + 1

    # Outer ring: 10 fans (zones 7..16), clockwise from 12 o'clock
    j = 0
    while j < 10:
        theta = -pi * 0.5 + j * (2.0 * pi / 10.0)
        vx = r_out_x * cos(theta)
        vy = r_out_y * sin(theta)
        dist = max(1.0, sqrt(vx * vx + vy * vy))
        ux = vx / dist
        uy = vy / dist
        ang = atan2(vy, vx) * rad_to_deg + 90.0
        px = cx + vx - cw * 0.5
        py = cy + vy - ch * 0.5
        set_zone_pose(7 + j, px, py, ang, 7 + j)
        set_zone_fan(7 + j, ux, uy)
        set_zone_fan_step(7 + j, fan_step)
        j = j + 1
    return True

