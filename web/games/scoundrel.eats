# =============================================================================
# SolEngine Game Family: Scoundrel (.eats)
# Consolidated variants:
#   - Scoundrel (44-Card Classic Dungeon Crawl)
#   - Scoundrel in Training (52-Card Beginner Variant)
# =============================================================================

# --- Shared Scoundrel Dungeon-Crawl Helpers ---

def sc_card_power(z, i):
    r = card_rank(z, i)
    if r == 1:
        return 14
    return r

def sc_tag_card_rpg(z, i):
    s = card_suit(z, i)
    p = sc_card_power(z, i)
    if s == 0 or s == 3:
        set_card_stat(z, i, "attack", p)
        add_card_tag(z, i, "monster")
    elif s == 2:
        set_card_stat(z, i, "attack", p)
        add_card_tag(z, i, "weapon")
    else:
        set_card_stat(z, i, "hp", p)
        add_card_tag(z, i, "potion")

def sc_room_card_count():
    cnt = 0
    z = 3
    while z <= 6:
        if zone_size(z) > 0:
            cnt = cnt + 1
        z = z + 1
    return cnt

def sc_deal_empty_room_slots():
    z = 3
    while z <= 6:
        if zone_size(z) == 0 and zone_size(0) > 0:
            top = zone_size(0) - 1
            move_cards(0, top, z)
            flip_card(z, 0, True)
            sc_tag_card_rpg(z, 0)
        z = z + 1

def sc_refill_room():
    sc_deal_empty_room_slots()
    set_stat("POTION_USED", 0)
    set_stat("FLEE_USED", 0)

def sc_resolve_potion(z, i):
    p = sc_card_power(z, i)
    if get_stat("POTION_USED", 0) == 0:
        hp = get_stat("HP", 20)
        new_hp = hp + p
        if new_hp > 20:
            new_hp = 20
        set_stat("HP", new_hp)
        set_stat("POTION_USED", 1)
        add_score(p * 10)
    move_cards(z, i, 1)
    return True

def sc_resolve_weapon(z, i):
    p = sc_card_power(z, i)
    if zone_size(2) > 0:
        move_cards(2, 0, 1)
    move_cards(z, i, 2)
    set_stat("WEAPON", p)
    set_stat("CAP", 99)
    set_card_stat(2, 0, "durability", 99)
    add_score(p * 5)
    return True

def sc_resolve_monster(z, i, use_weapon):
    p = sc_card_power(z, i)
    hp = get_stat("HP", 20)
    wpn = get_stat("WEAPON", 0)
    cap = get_stat("CAP", 99)
    dmg = p
    if use_weapon and wpn > 0 and p <= cap:
        dmg = p - wpn
        if dmg < 0:
            dmg = 0
        set_stat("CAP", p)
        if zone_size(2) > 0:
            set_card_stat(2, 0, "durability", p)

    new_hp = hp - dmg
    if new_hp < 0:
        new_hp = 0
    set_stat("HP", new_hp)
    move_cards(z, i, 1)
    add_score(p * 15)
    return True

def sc_eval(hp_wt, wpn_wt, cap_wt, rem_wt):
    hp = get_stat("HP", 20)
    wpn = get_stat("WEAPON", 0)
    cap = get_stat("CAP", 99)
    eff_cap = cap
    if cap >= 99:
        eff_cap = 14
    flee = get_stat("FLEE_USED", 0)
    remaining = zone_size(0) + sc_room_card_count()
    return hp * hp_wt + wpn * wpn_wt + eff_cap * cap_wt - remaining * rem_wt - flee * 40

def sc_classic_eval():
    return sc_eval(90, 30, 10, 220)

def sc_rookie_eval():
    return sc_eval(70, 35, 30, 180)

def sc_on_deal():
    set_stat("HP", 20)
    set_stat("WEAPON", 0)
    set_stat("CAP", 99)
    set_stat("POTION_USED", 0)
    set_stat("FLEE_USED", 0)
    z = 3
    while z <= 6:
        if zone_size(z) > 0:
            sc_tag_card_rpg(z, 0)
        z = z + 1
    return True

def sc_can_pick(z, i):
    return z >= 3 and z <= 6 and card_face_up(z, i)

def sc_can_drop(from_z, i, to_z):
    if from_z < 3 or from_z > 6:
        return False
    if not card_face_up(from_z, i):
        return False
    # Only allow dragging a Monster to Graveyard (zone 1) to fight BAREHANDED
    # when an eligible weapon is equipped; all other actions use click-to-resolve
    # so the solver does not explore duplicate branches.
    if to_z == 1:
        s = card_suit(from_z, i)
        if s == 0 or s == 3:
            wpn = get_stat("WEAPON", 0)
            cap = get_stat("CAP", 99)
            return wpn > 0 and sc_card_power(from_z, i) <= cap
    return False

def sc_on_drop(from_z, i, to_z):
    if not sc_can_drop(from_z, i, to_z):
        return False
    return sc_resolve_monster(from_z, i, False)

def sc_on_card_click(z, i):
    if z < 3 or z > 6:
        return False
    if zone_size(z) == 0:
        return False
    s = card_suit(z, i)
    if s == 1:
        return sc_resolve_potion(z, i)
    if s == 2:
        return sc_resolve_weapon(z, i)
    return sc_resolve_monster(z, i, True)

def sc_on_stock_click():
    if zone_size(0) == 0:
        return False
    cnt = sc_room_card_count()
    if cnt == 4:
        if get_stat("FLEE_USED", 0) != 0:
            return False
        z = 3
        while z <= 6:
            if zone_size(z) > 0:
                flip_card(z, 0, False)
                move_cards_bottom(z, 0, 0)
            z = z + 1
        sc_deal_empty_room_slots()
        set_stat("POTION_USED", 0)
        set_stat("FLEE_USED", 1)
        return True
    if cnt <= 1:
        sc_refill_room()
        return True
    return False

def sc_on_turn_end():
    if sc_room_card_count() <= 1 and zone_size(0) > 0:
        sc_refill_room()
    return True

def sc_get_status():
    if get_stat("HP", 20) <= 0:
        return "defeat"
    if zone_size(0) == 0 and sc_room_card_count() == 0:
        return "victory"
    return "playing"

# =============================================================================
# Variant Definitions
# =============================================================================

