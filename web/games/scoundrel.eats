    eval_heuristic: sc_classic_eval,
    on_deal: sc_on_deal,
    can_pick: sc_can_pick,
    can_drop: sc_can_drop,
    on_drop: sc_on_drop,
    on_card_click: sc_on_card_click,
    on_stock_click: sc_on_stock_click,
    on_turn_end: sc_on_turn_end,
    get_status: sc_get_status,
    doc: {
        meta: [2, "Quick", 3, "25%-55%", 3, "Tactical"],
        aliases: ["Dungeon Solitaire", "Scoundrel Card Game"],
        goal: ["Clear the entire 44-card Dungeon deck and Room without falling to 0 HP.", "Your HP drops to 0 during combat."],
        zones: [
            { index: 0, name: "Dungeon Deck", desc: "44-card deck (no Red Face Cards or Red Aces). Click when all 4 Room cards are untouched to Flee.", examples: ["AS", "KC"], bullets: ["Deals 3 cards when 1 [[Room]] card remains.", "Click with 4 untouched Room cards to [[Flee]] (once per room; not twice in a row)."] },
            { index: 1, name: "Graveyard", desc: "Slain monsters, consumed potions, and replaced weapons.", bullets: ["Drag an eligible [[Monster]] here to fight BAREHANDED (preserves weapon [[CAP]])."] },
            { index: 2, name: "Equipped Weapon", desc: "Active Diamond weapon (2-10).", examples: ["7D", "4D"], bullets: ["Equipping a new Diamond replaces your current weapon (discards the old one) and resets [[CAP]].", "Subtracts weapon value from monster value (minimum 0 damage)."] },
            { index: 3, name: "Room Slot 1", desc: "Active dungeon encounter card.", examples: ["10S", "5H", "7D"], bullets: ["Click to resolve (uses Weapon if <= [[CAP]]), or drag a [[Monster]] to [[Graveyard]] to fight barehanded."] },
            { index: 4, name: "Room Slot 2", desc: "Active dungeon encounter card.", bullets: ["Resolve 3 of 4 cards; the 4th carries over into the next [[Room]]."] },
            { index: 5, name: "Room Slot 3", desc: "Active dungeon encounter card." },
            { index: 6, name: "Room Slot 4", desc: "Active dungeon encounter card." }
        ],
        rules: [
            { title: "Resolving Monsters", bullets: ["Barehanded: Take damage equal to the monster's value (Ace = 14) and discard it to [[Graveyard]].", "With a Weapon: Subtract your weapon's value from the monster's value; take only the difference as damage (minimum 0).", "Drag an eligible [[Monster]] to [[Graveyard]] to fight barehanded instead of using your weapon."] },
            { title: "Weapon Limit (CAP)", bullets: ["A fresh [[Weapon]] has no limit and can fight any monster once.", "After killing a monster with a weapon, [[CAP]] drops to that monster's value.", "Subsequent fights with that weapon can only target monsters with value <= [[CAP]] (stronger monsters must be fought barehanded)."] },
            { title: "Weapons & Potions", bullets: ["Equipping a new Diamond replaces your current weapon, discarding the old one and resetting [[CAP]].", "[[Potion]] cards (Hearts) heal HP up to 20, but only 1 potion heals per [[Room]]; extra potions are discarded with no effect."] },
            { title: "Fleeing", bullets: ["Click [[Dungeon Deck]] when all 4 Room cards are untouched to move them to the bottom and deal 4 new cards. Cannot flee two Rooms in a row."] }
        ],
        stats: [
            { key: "HP", name: "Hit Points", desc: "Starts at 20 (max 20). Reaching 0 ends the run in defeat." },
            { key: "WEAPON", name: "Weapon Power", desc: "Attack value of your currently equipped Diamond weapon (2-10)." },
            { key: "CAP", name: "Weapon Durability Cap", desc: "Maximum monster value your current weapon can still block (<= CAP; 99 when fresh)." },
            { key: "POTION_USED", name: "Room Potion Limit", desc: "Only 1 Heart potion may heal per Room; extra potions are discarded with no effect." },
            { key: "FLEE_USED", name: "Flee Cooldown", desc: "1 if you fled the previous Room (cannot flee two Rooms in a row)." }
        ],
        tags: [
            { tag: "monster", name: "Monsters (Spades & Clubs 2-A)", desc: "Value equals rank (Ace = 14). Click to fight with Weapon (if <= [[CAP]]) or barehanded; drag to [[Graveyard]] to force barehanded." },
            { tag: "weapon", name: "Weapons (Diamonds 2-10)", desc: "Equip to subtract weapon value from monster damage; replaces any existing weapon." },
            { tag: "potion", name: "Potions (Hearts 2-10)", desc: "Restores HP up to 20 (max 1 healing potion per [[Room]])." }
        ]
    }
})

