# =============================================================================
# SolEngine Game Variant: Canfield (.eats)
# =============================================================================
name = "Canfield"
family = "Canfield"
category = "POPULAR"
layout = "canfield"
description = "Famous Saratoga casino classic. 13-card reserve, wrapping alternating cascades, and foundation starter card."
decks = 1
tableaus = 4
foundations = 4
freecells = 1

tableau_deal_counts = [1, 1, 1, 1]
tableau_all_face_up = True
foundation_starter_card = True

stock_deal_mode = "waste_draw_3"
stock_deal_count = 3
max_redeals = -1
demo_seed = 19
demo_seeds = [19, 22, 33, 58, 64, 106, 113, 301]

# --- Unified Help & Introspection Manifest ---
doc_meta(2, "Quick", 4, "High Luck", 3, "Tactical")
doc_aliases(["Demon", "Fascination"])
doc_goal("Build all 4 Foundations up in suit wrapping K->A from the starter rank.", "No legal moves remain.")
doc_stat("BASE_RANK", "Foundation Base Rank", "Rank of the initial starter card; all 4 Foundations begin on this rank.")
doc_zone(0, "Stock", "Click to turn 3 cards into Waste; unlimited redeals.")
doc_zone(1, "Waste", "Top card may be played to Foundations or Tableau.")
doc_zone(2, "Foundations (1-4)", "Build up in suit wrapping from King to Ace, starting at BASE_RANK.")
doc_zone(6, "Reserve (13 Cards)", "Top card is playable; automatically refills empty Tableau columns.")
doc_zone(7, "Tableau Columns (1-4)", "Build down in alternating colors (wrapping Ace->King); whole columns move together.")

def eval_heuristic():
    score = 0
    z = 2
    while z <= 5:
        score = score + zone_size(z) * 120
        z = z + 1
    return score - zone_size(6) * 30

def on_deal():
    if zone_size(2) > 0:
        set_stat("BASE_RANK", card_rank(2, 0))
    else:
        set_stat("BASE_RANK", 1)
    return True

def can_pick(z, i):
    sz = zone_size(z)
    if sz == 0 or i < 0 or i >= sz:
        return False
    if z == 1 or z == 6:
        return i == sz - 1
    if z >= 7 and z <= 10:
        return i == 0 or i == sz - 1
    return False

def can_drop(from_z, i, to_z):
    if from_z == to_z or zone_size(from_z) == 0:
        return False
    sz = zone_size(from_z)
    r = card_rank(from_z, i)
    s = card_suit(from_z, i)
    red = card_is_red(from_z, i)

    if to_z >= 2 and to_z <= 5:
        if i != sz - 1:
            return False
        fsz = zone_size(to_z)
        if fsz == 0:
            return r == get_stat("BASE_RANK", 1)
        top_r = card_rank(to_z, fsz - 1)
        next_r = (top_r % 13) + 1
        return card_suit(to_z, fsz - 1) == s and r == next_r

    if to_z >= 7 and to_z <= 10:
        # Whole column moves when dragging from tableau onto tableau
        if from_z >= 7 and from_z <= 10 and i != 0:
            return False
        tsz = zone_size(to_z)
        if tsz == 0:
            if from_z == 6:
                return True
            return zone_size(6) == 0 and (from_z == 1 or (from_z >= 7 and from_z <= 10))
        top_r = card_rank(to_z, tsz - 1)
        next_down = (r % 13) + 1
        return (card_is_red(to_z, tsz - 1) != red) and (top_r == next_down)

    return False

def on_stock_click():
    if zone_size(0) > 0:
        k = 0
        while k < 3 and zone_size(0) > 0:
            top = zone_size(0) - 1
            move_cards(0, top, 1)
            flip_card(1, zone_size(1) - 1, True)
            k = k + 1
        return True
    if zone_size(1) > 0:
        while zone_size(1) > 0:
            top = zone_size(1) - 1
            move_cards(1, top, 0)
            flip_card(0, zone_size(0) - 1, False)
        return True
    return False

def on_turn_end():
    z = 7
    while z <= 10:
        if zone_size(z) == 0 and zone_size(6) > 0:
            top = zone_size(6) - 1
            move_cards(6, top, z)
            flip_card(z, 0, True)
        z = z + 1
    rsz = zone_size(6)
    if rsz > 0 and not card_face_up(6, rsz - 1):
        flip_card(6, rsz - 1, True)
    return True

def get_status():
    total = zone_size(2) + zone_size(3) + zone_size(4) + zone_size(5)
    if total == 52:
        return "victory"
    return "playing"
