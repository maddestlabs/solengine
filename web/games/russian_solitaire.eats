# =============================================================================
# SolEngine Game Variant: Russian Solitaire (.eats)
# =============================================================================
# A rigorous, deeply satisfying variant of Yukon.
# All 52 cards dealt to the 7 tableaus.
# Tableau stacks build down strictly in the SAME SUIT!
# Any face-up card stack can be moved regardless of sequence.

name = "Russian Solitaire"
family = "Yukon"
category = "POPULAR"
description = "High-mastery Yukon variant. Tableaux build down strictly in the same suit; any face-up stack can move."
decks = 1
tableaus = 7
foundations = 4
freecells = 0

# Deal configuration: same as Yukon (52 cards across 7 columns)
tableau_deal_counts = [1, 6, 7, 8, 9, 10, 11]
tableau_all_face_up = False
foundation_starter_card = False

# No stock pile
stock_deal_mode = "none"
stock_deal_count = 0
max_redeals = 0

def can_drop_tableau(dest_card, moving_card):
    """Tableaux build down by the SAME SUIT. Empty spaces accept Kings only."""
    if dest_card.is_empty:
        return moving_card.rank == 13 # King
    return (dest_card.suit == moving_card.suit) and (dest_card.rank == moving_card.rank + 1)

def can_lift_sequence(cards):
    """Any stack of face-up cards can be moved as a unit (unsequenced)."""
    return True

def can_drop_foundation(foundation_card, moving_card):
    """Foundations build up by same suit from Ace to King."""
    if foundation_card.is_empty:
        return moving_card.rank == 1 # Ace
    return (foundation_card.suit == moving_card.suit) and (moving_card.rank == foundation_card.rank + 1)

