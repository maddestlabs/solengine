# =============================================================================
# SolEngine Game Family: Baker's Dozen (.eats)
# Consolidated variants:
#   - Baker's Dozen
# =============================================================================

# --- Shared Baker's Dozen Rules ---

def bd_eval():
    score = 0
    z = 0
    while z <= 3:
        score = score + zone_size(z) * 150
        z = z + 1
    z = 4
    while z <= 16:
        sz = zone_size(z)
        i = 0
        while i < sz - 1:
            if card_rank(z, i) == card_rank(z, i + 1) + 1:
                score = score + 15
            i = i + 1
        z = z + 1
    return score

def bd_on_deal():
    # Sink Kings to the bottom of each column using temporary empty foundations 0 and 1
    z = 4
    while z <= 16:
        while zone_size(z) > 0:
            top = zone_size(z) - 1
            if card_rank(z, top) == 13:
                move_cards(z, top, 1)
            else:
                move_cards(z, top, 0)
        while zone_size(1) > 0:
            move_cards(1, zone_size(1) - 1, z)
        while zone_size(0) > 0:
            move_cards(0, zone_size(0) - 1, z)
        z = z + 1
    return True

def bd_can_pick(z, i):
    sz = zone_size(z)
    if z < 4 or z > 16 or sz == 0:
        return False
    return i == sz - 1

def bd_can_drop(from_z, i, to_z):
    if from_z == to_z or zone_size(from_z) == 0:
        return False
    if i != zone_size(from_z) - 1:
        return False
    r = card_rank(from_z, i)
    s = card_suit(from_z, i)

    if to_z >= 0 and to_z <= 3:
        fsz = zone_size(to_z)
        if fsz == 0:
            return r == 1
        return card_suit(to_z, fsz - 1) == s and r == card_rank(to_z, fsz - 1) + 1

    if to_z >= 4 and to_z <= 16:
        tsz = zone_size(to_z)
        if tsz == 0:
            return False
        return card_rank(to_z, tsz - 1) == r + 1

    return False

def bd_status():
    total = zone_size(0) + zone_size(1) + zone_size(2) + zone_size(3)
    if total == 52:
        return "victory"
    return "playing"

