    layout: "fan_grid",
    tableau_build: "any_suit",
    empty_tableau: "none",
    move_group: "single",
    foundation_mode: "suit_up",
    description: "13 columns of 4 open cards. Build down regardless of suit; Kings sink to column bottom; spaces remain empty.",
    decks: 1,
    tableaus: 13,
    foundations: 4,
    freecells: 0,
    tableau_deal_counts: [4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4],
    tableau_all_face_up: True,
    foundation_starter_card: False,
    stock_deal_mode: "none",
    max_redeals: 0,
    demo_seed: 14,
    demo_seeds: [14, 19, 24, 27, 29, 35, 39, 45],
    eval_heuristic: bd_eval,
    on_deal: bd_on_deal,
    can_pick: bd_can_pick,
    can_drop: bd_can_drop,
    get_status: bd_status,
    doc: {
        meta: [2, "Quick", 2, "Low Luck", 4, "Tactical"],
        aliases: ["Spanish Patience"],
        goal: ["Build all 4 Foundations up in suit from Ace to King.", "No legal moves remain."],
        zones: [
            { index: 0, name: "Foundations (1-4)", desc: "Build up by same suit from Ace to King.", examples: ["AS", "2S", "3S"] },
            { index: 4, name: "Tableau Columns (1-13)", desc: "Build down by rank regardless of suit; Kings sink to bottom; empty spaces cannot be refilled.", examples: ["KH", "QD", "JC"] }
        ]
    }
})
