    tableau_build: "same_suit",
    empty_tableau: "any",
    move_group: "single",
    foundation_mode: "suit_up",
    description: "Classic 2-deck skill game. Build down by same suit; single card movement; 8 foundations.",
    decks: 2,
    tableaus: 10,
    foundations: 8,
    freecells: 0,
    tableau_deal_counts: [4, 4, 4, 4, 4, 4, 4, 4, 4, 4],
    tableau_all_face_up: True,
    foundation_starter_card: False,
    stock_deal_mode: "waste_draw_1",
    stock_deal_count: 1,
    max_redeals: 0,
    demo_seed: 60,
    demo_seeds: [60, 72, 103, 105, 110, 131, 155, 178],
    eval_heuristic: ft_eval,
    can_pick: ft_can_pick,
    can_drop: ft_can_drop,
    on_stock_click: ft_on_stock,
    get_status: ft_status,
    doc: {
        meta: [4, "Long", 3, "Moderate", 5, "Master"],
        aliases: ["Napoleon at St. Helena", "Big Forty"],
        goal: ["Build all 8 Foundations up in suit from Ace to King.", "No legal moves remain."],
        zones: [
            { index: 0, name: "Stock", desc: "Click to turn 1 card into the Waste; 0 redeals." },
            { index: 1, name: "Waste", desc: "Top card may be played to Foundations or Tableau." },
            { index: 2, name: "Foundations (1-8)", desc: "Build up by same suit from Ace to King.", examples: ["AS", "2S", "3S"] },
            { index: 10, name: "Tableau Columns (1-10)", desc: "Build down in the SAME SUIT; only the top card may move; any card fills empty columns.", examples: ["KS", "QS", "JS"] }
        ]
    }
})
