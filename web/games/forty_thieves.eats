# =============================================================================
# SolEngine Game Family: Forty Thieves (.eats)
# Consolidated variants:
#   - Forty Thieves
# =============================================================================

# --- Shared Forty Thieves Rules ---

def ft_eval():
    score = 0
    z = 2
    while z <= 9:
        score = score + zone_size(z) * 200
        z = z + 1
    z = 10
    while z <= 19:
        sz = zone_size(z)
        if sz == 0:
            score = score + 50
        else:
            i = 0
            while i < sz - 1:
                if card_suit(z, i) == card_suit(z, i + 1) and card_rank(z, i) == card_rank(z, i + 1) + 1:
                    score = score + 35
                i = i + 1
        z = z + 1
    return score - zone_size(1) * 5

def ft_can_pick(z, i):
    sz = zone_size(z)
    if sz == 0 or i < 0 or i >= sz:
        return False
    if z == 1 or (z >= 10 and z <= 19):
        return i == sz - 1
    return False

def ft_can_drop(from_z, i, to_z):
    if from_z == to_z or zone_size(from_z) == 0:
        return False
    sz = zone_size(from_z)
    if i != sz - 1:
        return False
    r = card_rank(from_z, i)
    s = card_suit(from_z, i)

    if to_z >= 2 and to_z <= 9:
        fsz = zone_size(to_z)
        if fsz == 0:
            return r == 1
        return card_suit(to_z, fsz - 1) == s and r == card_rank(to_z, fsz - 1) + 1

    if to_z >= 10 and to_z <= 19:
        tsz = zone_size(to_z)
        if tsz == 0:
            return True
        return card_suit(to_z, tsz - 1) == s and card_rank(to_z, tsz - 1) == r + 1

    return False

def ft_on_stock():
    if zone_size(0) > 0:
        top = zone_size(0) - 1
        move_cards(0, top, 1)
        flip_card(1, zone_size(1) - 1, True)
        return True
    return False

def ft_status():
    total = 0
    z = 2
    while z <= 9:
        total = total + zone_size(z)
        z = z + 1
    if total == 104:
        return "victory"
    return "playing"

