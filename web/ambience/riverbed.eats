# ==============================================================================
# SolEngine Procedural Ambience: Riverbed (.eats)
# Flowing woodland stream with liquid stone babble, occasional soft splashes,
# sparkling surface spray, and subtle streamside birds.
# ==============================================================================

sol.define_ambience({
    id: "riverbed",
    name: "Riverbed",
    master_gain: 1.0,
    layers: [
        # 1. Deep river body rumble
        {
            type: "noise_bed",
            color: "brown",
            filter: "lowpass",
            cutoff: 360.0,
            q: 0.707,
            gain: 0.34,
            lfo_rate: 0.13,
            lfo_depth: 65.0,
            amp_mod: 0.14
        },
        # 2. Undulating mid-stream current over stones
        {
            type: "noise_bed",
            color: "pink",
            filter: "bandpass",
            cutoff: 1150.0,
            q: 0.65,
            gain: 0.27,
            lfo_rate: 0.21,
            lfo_depth: 320.0,
            amp_mod: 0.18
        },
        # 3. Liquid babbling & Minnaert water-bubble resonances
        {
            type: "stochastic_grains",
            tonal: true,
            rate: 6.5,
            freq_min: 380.0,
            freq_max: 1150.0,
            freq_sweep: 1.72,
            decay: 0.036,
            gain: 0.14,
            stereo_spread: 0.85
        },
        # 4. Crisp surface riffle & fine water spray
        {
            type: "stochastic_grains",
            rate: 11.0,
            freq_min: 1900.0,
            freq_max: 5200.0,
            decay: 0.014,
            q: 1.6,
            gain: 0.11,
            stereo_spread: 0.88
        },
        # 5. Occasional soft water splashes & bank laps
        {
            type: "stochastic_grains",
            rate: 0.42,
            freq_min: 520.0,
            freq_max: 1450.0,
            freq_sweep: 0.62,
            decay: 0.15,
            q: 0.85,
            gain: 0.19,
            stereo_spread: 0.90
        },
        # 6. Subtle, sparse river-dwelling birds
        {
            type: "chirp_spawner",
            tonal: true,
            rate: 0.28,
            freq_min: 1950.0,
            freq_max: 3750.0,
            freq_sweep: 1.24,
            decay: 0.16,
            gain: 0.14,
            stereo_spread: 0.88
        }
    ]
})
