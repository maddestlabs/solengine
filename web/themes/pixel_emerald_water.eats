# SolEngine Procedural Background Theme — Pixel Emerald Water
# Pure Eatscript Bytecode Shader: Retro 16-bit aquatic shimmering water surface with pixel dithering

sol.set_theme({
    id: "pixel_emerald_water",
    name: "Pixel Emerald Water",
    author: "SolEngine / Eatscript",
    description: "Retro 16-bit RPG shimmering aquatic water surface with cyan caustics and dithered wave crests",
    version: 2,
    procedural: true
})

def pixel_water_shader(u, v, nx, ny, in_r, in_g, in_b):
    # 1. Pixel grid quantization
    px_x = floor((nx + 1.0) * 96.0) / 96.0
    px_y = floor((ny + 1.0) * 64.0) / 64.0

    # 2. Caustic wave harmonics
    w1 = sin((px_x * 8.0 + px_y * 14.0) * 3.14159)
    w2 = sin((px_x * 12.0 - px_y * 10.0) * 3.14159)
    caustic = pow(max(0.0, (w1 + w2) * 0.5), 2.5)

    # 3. Wave foam & dither
    dither = ((floor((nx + 1.0) * 96.0) + floor((ny + 1.0) * 64.0)) % 2) * 0.05
    foam = smoothstep(0.65, 0.90, caustic + dither)

    # 4. Vivid aquatic gradient
    # Deep ocean blue (#0b315b) -> Vivid teal (#008fbb) -> Cyan caustic (#2ce8f5) -> White crest
    t = caustic + dither * 0.4
    base_r = mix(0.04, 0.16, t) + foam * 0.45
    base_g = mix(0.20, 0.62, t) + foam * 0.55
    base_b = mix(0.40, 0.85, t) + foam * 0.50

    dist = hypot(nx * 0.95, ny)
    vignette = smoothstep(1.35, 0.45, dist)

    r = clamp(base_r * vignette, 0.0, 1.0)
    g = clamp(base_g * vignette, 0.0, 1.0)
    b = clamp(base_b * vignette, 0.0, 1.0)
    return [r, g, b]

def on_draw_background(ctx, w, h):
    ctx.fill_rect(0, 0, w, h, "#072444")
    inset = 18.0
    ctx.stroke_rect(inset, inset, w - inset * 2.0, h - inset * 2.0, "#0b4e78", 2.0)
    ctx.apply_shader("pixel_water_shader", intensity=1.0)
