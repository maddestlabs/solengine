# SolEngine Custom Background Theme — Verde Alpi Marble
# Alpine deep serpentine green metamorphic stone with jade ribbons, seafoam calcite veins & brass inlay

sol.set_theme({
    id: "shader_verde_marble",
    name: "Verde Alpi Marble",
    author: "SolEngine / Eatscript",
    description: "Deep Alpine green serpentine marble with jade ribbons and pale calcite fracture veins",
    version: 1,
    procedural: true
})

def verde_shader(u, v, nx, ny, in_r, in_g, in_b):
    dist = hypot(nx * 0.9, ny)

    # 1. Dual Domain Warping (Folded metamorphic serpentine shearing)
    qx = fbm(nx * 2.8, ny * 2.8)
    qy = fbm(nx * 2.8 + 4.9, ny * 2.8 + 1.8)

    rx = fbm(nx * 2.8 + qx * 3.4, ny * 2.8 + qy * 3.4)
    ry = fbm(nx * 2.8 + qx * 3.4 + 1.9, ny * 2.8 + qy * 3.4 + 8.5)

    field = fbm(nx * 2.8 + rx * 2.9, ny * 2.8 + ry * 2.9)

    # 2. Crystalline calcite and seafoam fracture seams
    vein_raw = abs(sin((field + nx * 0.42 - ny * 0.32) * 6.0))
    veins = 1.0 - smoothstep(0.02, 0.18, vein_raw)
    fine_veins = (1.0 - smoothstep(0.01, 0.06, abs(sin(field * 19.0)))) * 0.3

    # 3. Deep serpentine green stone with pale seafoam/white veins
    base = 0.22 + field * 0.08
    vein_boost = veins * 0.42 + fine_veins * 0.22

    mr = base * 0.40 + vein_boost * 0.65
    mg = base * 0.85 + vein_boost * 0.88
    mb = base * 0.58 + vein_boost * 0.72

    # 4. Photographic vignette to draw focus to center
    vignette = smoothstep(1.4, 0.45, dist)
    grain = (random() - 0.5) * 0.015

    # Composite with vector inlay from canvas
    r = clamp(mix(mr * vignette, in_r, in_r * 0.7) + grain, 0.0, 1.0)
    g = clamp(mix(mg * vignette, in_g, in_g * 0.7) + grain, 0.0, 1.0)
    b = clamp(mix(mb * vignette, in_b, in_b * 0.7) + grain, 0.0, 1.0)
    return [r, g, b]

def on_draw_background(ctx, w, h):
    # 1. Base deep serpentine green fill
    ctx.fill_rect(0, 0, w, h, "#1d3326")

    # 2. Royal polished gold inlay border around table perimeter
    inset = 20.0
    ctx.stroke_rect(inset, inset, w - inset * 2.0, h - inset * 2.0, "#d4af37", 2.5)
    ctx.stroke_rect(inset + 4.0, inset + 4.0, w - (inset + 4.0) * 2.0, h - (inset + 4.0) * 2.0, "#2c2206", 1.0)

    # 3. Run full-canvas marble shader
    ctx.apply_shader("verde_shader", intensity=1.0)

