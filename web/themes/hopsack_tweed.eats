# SolEngine Procedural Background Theme — Hopsack Tweed
# Pure Eatscript Bytecode Shader: 2x2 basketweave tweed with fine thread grooves & multi-color neps

sol.set_theme({
    id: "ambientcg_fabric063",
    name: "Hopsack Tweed",
    author: "SolEngine / Eatscript",
    description: "Heather neutral hopsack tweed with 2x2 basketweave blocks and multi-colored wool specks",
    version: 2,
    procedural: true
})

def hopsack_shader(u, v, nx, ny, in_r, in_g, in_b, px, py):
    dist = hypot(nx * 0.95, ny)

    # 1. 2x2 Basketweave Block Pattern (1:1 scale: 9.0px per block)
    block_x = floor(px / 9.0)
    block_y = floor(py / 9.0)
    is_horiz = ((block_x + block_y) % 2) == 0

    fine_thread = sin((px if is_horiz else py) * 0.9) * 0.05
    block_tone = 0.08 if is_horiz else -0.06

    # 2. Heather neutral wool body
    wool = (fbm(px * 0.06, py * 0.06) - 0.5) * 0.05

    # 3. Tweed neps (pink, cyan, amber wool specks at 1:1 pixel frequency)
    nep_rnd = random()
    nep_r = 0.0
    nep_g = 0.0
    nep_b = 0.0
    if nep_rnd > 0.988:
        nep_type = (block_x * 17.0 + block_y * 31.0) % 3
        if nep_type == 0:
            nep_r = 0.25
            nep_g = -0.05
            nep_b = 0.05
        elif nep_type == 1:
            nep_r = -0.05
            nep_g = 0.15
            nep_b = 0.25
        else:
            nep_r = 0.25
            nep_g = 0.18
            nep_b = -0.05

    base_luma = 0.32 + block_tone + fine_thread + wool
    base_r = base_luma * 1.02 + nep_r
    base_g = base_luma * 1.00 + nep_g
    base_b = base_luma * 0.96 + nep_b

    # 4. Vignette optical falloff
    vignette = smoothstep(1.35, 0.40, dist)
    grain = (random() - 0.5) * 0.015

    r = clamp(base_r * vignette + grain, 0.0, 1.0)
    g = clamp(base_g * vignette + grain, 0.0, 1.0)
    b = clamp(base_b * vignette + grain, 0.0, 1.0)
    return [r, g, b]

def on_draw_background(ctx, w, h):
    # 1. Base heather gray
    ctx.fill_rect(0, 0, w, h, "#40403e")

    # 2. Tweed braided border
    inset = 18.0
    ctx.stroke_rect(inset, inset, w - inset * 2.0, h - inset * 2.0, "#2c2c2a", 2.0)

    # 3. Run hopsack shader
    ctx.apply_shader("hopsack_shader", intensity=1.0)
