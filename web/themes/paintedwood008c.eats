# SolEngine Procedural Background Theme — Painted Wood 008C
# Pure Eatscript Bytecode Shader: Weathered painted wood planks with visible timber grain

sol.set_theme({
    id: "ambientcg_paintedwood008c",
    name: "Painted Wood 008C",
    author: "SolEngine / Eatscript",
    description: "Weathered antique painted wood planks with continuous longitudinal grain and faded seams",
    version: 2,
    procedural: true
})

def wood_shader(u, v, nx, ny, in_r, in_g, in_b):
    dist = hypot(nx * 0.95, ny)

    # 1. Horizontal plank seams with precision-milled 3D beveled chamfers
    plank_coord = ny * 3.5
    plank_angle = plank_coord * 3.14159265
    plank_sin = sin(plank_angle)
    plank_cos = cos(plank_angle)
    plank_dist = abs(plank_sin)

    # Tight, crisp milled chamfer bevel (sharp 3-4% edge zone)
    bevel_zone = smoothstep(0.048, 0.004, plank_dist)
    bevel_light = clamp(plank_sin * plank_cos * 14.0, -1.0, 1.0) * bevel_zone * 0.075

    # Crisp, clean seam groove (narrow crevice with deep warm contact tone)
    seam_shade = 1.0 - smoothstep(0.020, 0.002, plank_dist) * 0.58

    # 2. Longitudinal hardwood timber grain (spatially modulated density)
    # Spatial density blend: creates natural variation between calm open wood and dense figure
    grain_density = smoothstep(0.30, 0.70, fbm(nx * 1.6, ny * 1.8))
    grain_warp = fbm(nx * 3.0, ny * 2.2) * 0.35

    # Calmer broad grain (smooth open wood zones)
    smooth_grain = (fbm(nx * 2.2, ny * 42.0 + grain_warp) - 0.5) * 0.15

    # Crisp growth rings (dense figure zones, lowered frequency for natural spacing)
    ring_phase = ny * 22.0 + grain_warp * 2.8
    ring_raw = abs(sin(ring_phase * 3.14159265))
    crisp_rings = (1.0 - ring_raw * ring_raw) * 0.15

    # Organic blend: calm sections stay open and soft, figure sections pop with ring detail
    grain = mix(smooth_grain, crisp_rings + smooth_grain * 0.5, grain_density)

    # High-frequency capillary micro-pores active primarily in denser figure zones
    pore_noise = fbm(nx * 6.5, ny * 130.0)
    micro_pores = (smoothstep(0.38, 0.62, pore_noise) - 0.5) * 0.05 * grain_density

    # 3. Weathered paint wear (paint worn thin exposing warm wood undertone)
    wear = fbm(nx * 2.5, ny * 3.0)

    # Bare warm oak wood (#382618)
    wood_r = 0.22 + grain + micro_pores
    wood_g = 0.16 + grain * 0.8 + micro_pores
    wood_b = 0.10 + grain * 0.5 + micro_pores * 0.4

    # Faded slate-sage milk paint (#3e4745)
    paint_r = 0.24 + micro_pores * 0.5
    paint_g = 0.28 + micro_pores * 0.5
    paint_b = 0.27 + micro_pores * 0.5

    base_r = (mix(wood_r, paint_r, wear) + bevel_light) * seam_shade
    base_g = (mix(wood_g, paint_g, wear) + bevel_light) * seam_shade
    base_b = (mix(wood_b, paint_b, wear) + bevel_light) * seam_shade

    # 4. Vignette falloff
    vignette = smoothstep(1.35, 0.42, dist)
    grain_speck = (random() - 0.5) * 0.012

    r = clamp(base_r * vignette + grain_speck, 0.0, 1.0)
    g = clamp(base_g * vignette + grain_speck, 0.0, 1.0)
    b = clamp(base_b * vignette + grain_speck, 0.0, 1.0)
    return [r, g, b]

def on_draw_background(ctx, w, h):
    ctx.fill_rect(0, 0, w, h, "#22201b")
    inset = 18.0
    ctx.stroke_rect(inset, inset, w - inset * 2.0, h - inset * 2.0, "#3e3a32", 1.8)
    ctx.apply_shader("wood_shader", intensity=1.0)
