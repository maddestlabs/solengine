# SolEngine Custom Background Theme — Grigio Carnico Marble
# Italian dark graphite-ash metamorphic stone with crystalline white calcite fracture veins & polished nickel inlay

sol.set_theme({
    id: "shader_grigio_marble",
    name: "Grigio Carnico",
    author: "SolEngine / Eatscript",
    description: "Polished Italian dark ash and graphite marble with striking white calcite fracture veins",
    version: 1,
    procedural: true
})

def grigio_shader(u, v, nx, ny, in_r, in_g, in_b):
    dist = hypot(nx * 0.9, ny)

    # 1. Dual Domain Warping (metamorphic shear & crystalline folding)
    qx = fbm(nx * 2.6, ny * 2.6)
    qy = fbm(nx * 2.6 + 5.7, ny * 2.6 + 2.1)

    rx = fbm(nx * 2.6 + qx * 3.6, ny * 2.6 + qy * 3.6)
    ry = fbm(nx * 2.6 + qx * 3.6 + 1.5, ny * 2.6 + qy * 3.6 + 8.7)

    field = fbm(nx * 2.6 + rx * 3.2, ny * 2.6 + ry * 3.2)

    # 2. Crisp bright calcite lightning fracture veins
    vein_raw = abs(sin((field + nx * 0.5 - ny * 0.35) * 5.8)) * abs(sin((field * 1.3 - nx * 0.3 + ny * 0.4) * 4.4))
    veins = 1.0 - smoothstep(0.015, 0.14, vein_raw)
    fine_veins = (1.0 - smoothstep(0.008, 0.05, abs(sin(field * 21.0)))) * 0.35

    # 3. Base charcoal/graphite palette with luminous white calcite veins
    # Mid-dark stone base (~0.35 albedo, comfortable glare-free reading contrast)
    base_luma = 0.32 + field * 0.08
    albedo = base_luma + veins * 0.52 + fine_veins * 0.28

    # 4. Neutral-cool graphite tint
    mr = albedo * 0.97
    mg = albedo * 0.99
    mb = albedo * 1.02

    # 5. Photographic vignette
    vignette = smoothstep(1.4, 0.45, dist)
    grain = (random() - 0.5) * 0.018

    # Composite with vector inlay from canvas
    r = clamp(mix(mr * vignette, in_r, in_r * 0.7) + grain, 0.0, 1.0)
    g = clamp(mix(mg * vignette, in_g, in_g * 0.7) + grain, 0.0, 1.0)
    b = clamp(mix(mb * vignette, in_b, in_b * 0.7) + grain, 0.0, 1.0)
    return [r, g, b]

def on_draw_background(ctx, w, h):
    # 1. Base graphite fill
    ctx.fill_rect(0, 0, w, h, "#4e5158")

    # 2. Brushed titanium & polished steel inlay border
    inset = 20.0
    ctx.stroke_rect(inset, inset, w - inset * 2.0, h - inset * 2.0, "#9ca3af", 2.2)
    ctx.stroke_rect(inset + 4.0, inset + 4.0, w - (inset + 4.0) * 2.0, h - (inset + 4.0) * 2.0, "#222429", 1.0)

    # 3. Run full-canvas marble shader
    ctx.apply_shader("grigio_shader", intensity=1.0)

