# SolEngine Custom Background Theme — Nero Marquina Marble
# Deep Spanish obsidian black marble with striking white calcite lightning veins & burnished copper inlay

sol.set_theme({
    id: "shader_nero_marquina",
    name: "Nero Marquina",
    author: "SolEngine / Eatscript",
    description: "Deep Spanish obsidian black marble with striking white calcite fracture veins",
    version: 1,
    procedural: true
})

def marquina_shader(u, v, nx, ny, in_r, in_g, in_b):
    dist = hypot(nx * 0.9, ny)

    # 1. Dual Domain Warping (metamorphic shear & tectonic folding)
    qx = fbm(nx * 2.5, ny * 2.5)
    qy = fbm(nx * 2.5 + 6.1, ny * 2.5 + 2.3)

    rx = fbm(nx * 2.5 + qx * 3.5, ny * 2.5 + qy * 3.5)
    ry = fbm(nx * 2.5 + qx * 3.5 + 1.8, ny * 2.5 + qy * 3.5 + 8.9)

    field = fbm(nx * 2.5 + rx * 3.0, ny * 2.5 + ry * 3.0)

    # 2. Sharp tectonic calcite fracture veins
    vein_raw = abs(sin((field + nx * 0.55 - ny * 0.4) * 6.0)) * abs(sin((field * 1.5 - nx * 0.35 + ny * 0.45) * 4.2))
    veins = 1.0 - smoothstep(0.012, 0.12, vein_raw)
    fine_veins = (1.0 - smoothstep(0.007, 0.04, abs(sin(field * 23.0)))) * 0.35

    # 3. Deep obsidian base stone (~0.12) with bright white calcite veins (~0.85)
    base_luma = 0.11 + field * 0.04
    albedo = base_luma + veins * 0.70 + fine_veins * 0.40

    # 4. Subtle charcoal tint
    mr = albedo * 0.98
    mg = albedo * 0.99
    mb = albedo * 1.01

    # 5. Photographic vignette
    vignette = smoothstep(1.4, 0.45, dist)
    grain = (random() - 0.5) * 0.015

    # Composite with vector inlay from canvas
    r = clamp(mix(mr * vignette, in_r, in_r * 0.7) + grain, 0.0, 1.0)
    g = clamp(mix(mg * vignette, in_g, in_g * 0.7) + grain, 0.0, 1.0)
    b = clamp(mix(mb * vignette, in_b, in_b * 0.7) + grain, 0.0, 1.0)
    return [r, g, b]

def on_draw_background(ctx, w, h):
    # 1. Base obsidian charcoal fill
    ctx.fill_rect(0, 0, w, h, "#18191c")

    # 2. Burnished rose gold & copper inlay border
    inset = 20.0
    ctx.stroke_rect(inset, inset, w - inset * 2.0, h - inset * 2.0, "#b8866e", 2.2)
    ctx.stroke_rect(inset + 4.0, inset + 4.0, w - (inset + 4.0) * 2.0, h - (inset + 4.0) * 2.0, "#301d16", 1.0)

    # 3. Run full-canvas marble shader
    ctx.apply_shader("marquina_shader", intensity=1.0)

