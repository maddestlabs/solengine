# ==============================================================================
# SolEngine Foley Preset: Bass-Heavy / Heavy Solid Oak Table (.eats)
# Deep sub-bass resonance, dense card weight, authoritative table landing.
# ==============================================================================

audio.set_master_volume(0.95)
audio.set_master_variance(1.1)

# Deal: Heavier linen friction with warm low-mid body
audio.define_sound("deal", {
    duration: { base: 0.068, dev: 0.12 },
    gain:     { base: 1.15,  dev: 0.06 },
    layers: [
        {
            generator: "noise",
            filter: { type: "bandpass", cutoff: { base: 1450.0, dev: 0.08 }, q: 1.10 },
            env: { attack: 0.005, decay: 1.6, curve: "sine" },
            weight: { base: 0.75, dev: 0.12 }
        },
        {
            generator: "noise",
            filter: { type: "bandpass", cutoff: { base: 2800.0, dev: 0.08 }, q: 1.15 },
            env: { attack: 0.004, decay: 1.8, curve: "sine" },
            weight: { base: 0.50, dev: 0.14 }
        },
        {
            generator: "sine",
            freq_start: { base: 110.0, dev: 0.05 },
            freq_end:   { base: 65.0,  dev: 0.06 },
            env: { attack: 0.002, decay: 12.0, curve: "punch" },
            weight: { base: 0.35, dev: 0.15 }
        }
    ]
})

# Place: Deep oak table thud with substantial sub-bass punch
audio.define_sound("place", {
    duration: { base: 0.095, dev: 0.10 },
    gain:     { base: 1.20,  dev: 0.06 },
    layers: [
        # Heavy sub-bass foundation
        {
            generator: "sine",
            freq_start: { base: 110.0, dev: 0.06 },
            freq_end:   { base: 34.0,  dev: 0.08 },
            env: { attack: 0.001, decay: 7.5, curve: "punch" },
            weight: { base: 1.05, dev: 0.12 }
        },
        # Deep wood cavity body
        {
            generator: "noise",
            filter: { type: "lowpass", cutoff: { base: 240.0, dev: 0.06 }, q: 1.30 },
            env: { attack: 0.001, decay: 11.0, curve: "punch" },
            weight: { base: 0.75, dev: 0.12 }
        },
        # Thick cardstock contact
        {
            generator: "noise",
            filter: { type: "bandpass", cutoff: { base: 480.0, dev: 0.08 }, q: 1.15 },
            env: { attack: 0.002, decay: 14.0, curve: "punch" },
            weight: { base: 0.40, dev: 0.14 }
        }
    ]
})

audio.define_sequence("shuffle", {
    intro_sound: "sweep",
    intro_gain:  0.95,
    flips: {
        count: { min: 7, max: 9 },
        base_gap: 0.062,
        gap_jitter: 0.14,
        deal_to_place_delay: { base: 0.038, dev: 0.10 },
        double_drop_chance: 0.30,
        double_drop_delay: { min: 0.009, max: 0.015 },
        stereo_alternation: 0.15
    },
    interspersed_sweeps: {
        chance: 0.45,
        max_sweeps: 3
    }
})
