# ==============================================================================
# SolEngine Foley Preset: Copag 100% Plastic (.eats)
# Sharp deflection, ultra-high slip, crisp synthetic snap
# ==============================================================================

def configure():
    audio.set_master_volume(0.85)
    audio.set_master_variance(1.0)

    audio.set_physical_params({
        velvet_density: 6000.0,
        edge_snap:      1.40,
        air_boost:      9.0,
        comb_delay:     0.00009,
        felt_damping:   13500.0,
        card_rigidity:  4800.0
    })

sol.define_sound_pack({
    id: "copag_plastic",
    name: "Copag",
    configure: configure
})
