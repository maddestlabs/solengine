# SolEngine Standalone Eatscript Card Back — Rippled Sands
# Reuses the domain-warped wind-rippled desert dune shader from themes/sands.eats
# framed in warm cream cardstock, burnished bronze trim, and a compass-rose medallion.

sol.define_card_back({
    id: "rippled_sands",
    name: "Rippled Sands",
    author: "Maddest Labs",
    description: "Wind-rippled golden desert dunes framed in warm ivory and burnished bronze"
})

def rippled_sands_back_shader(u, v, nx, ny, in_r, in_g, in_b, px, py):
    ax = abs(nx)
    ay = abs(ny)
    aa = 0.006

    # 1. Warm cream card stock border
    grain = (fbm(px * 0.22, py * 0.22) - 0.5) * 0.026
    ivory_r = 0.976 + grain
    ivory_g = 0.955 + grain
    ivory_b = 0.912 + grain

    qx_o = ax - 0.94
    qy_o = ay - 1.34
    d_outer = hypot(max(qx_o, 0.0), max(qy_o, 0.0)) + min(max(qx_o, qy_o), 0.0) - 0.06
    edge_shade = smoothstep(-0.025, 0.0, d_outer) * 0.11
    ivory_r = ivory_r - edge_shade
    ivory_g = ivory_g - edge_shade
    ivory_b = ivory_b - edge_shade * 0.9

    # 2. Inner dune panel SDF
    qx = ax - 0.81
    qy = ay - 1.21
    d_panel = hypot(max(qx, 0.0), max(qy, 0.0)) + min(max(qx, qy), 0.0) - 0.06
    in_panel = 1.0 - smoothstep(-aa, aa, d_panel)

    # 3. Domain-warped wind-rippled sand dunes (inspired by themes/sands.eats)
    warp = fbm(nx * 2.4 + 1.3, ny * 2.4 + 5.7) * 1.35
    phase = (nx * 0.72 + ny * 1.18) * 15.0 + warp * 3.6
    w0 = (0.5 + 0.5 * sin(phase)) ** 1.5

    warp_s = fbm((nx + 0.018) * 2.4 + 1.3, (ny + 0.026) * 2.4 + 5.7) * 1.35
    phase_s = ((nx + 0.018) * 0.72 + (ny + 0.026) * 1.18) * 15.0 + warp_s * 3.6
    w1 = (0.5 + 0.5 * sin(phase_s)) ** 1.5
    slope = clamp((w0 - w1) * 3.2, -0.26, 0.30)

    grain_fine = fract(sin(px * 12.9898 + py * 78.233) * 43758.5453)
    grain_med = fbm(px * 0.16, py * 0.16)
    speck_light = smoothstep(0.95, 0.995, fract(sin(px * 73.11 + py * 19.43) * 18392.3))

    ht = clamp(w0 * 0.76 + slope * 0.55 + (grain_med - 0.5) * 0.16, 0.0, 1.0)
    sand_r = mix(0.72, 0.95, ht) + (grain_fine - 0.46) * 0.045 + speck_light * 0.075
    sand_g = mix(0.57, 0.82, ht) + (grain_fine - 0.46) * 0.040 + speck_light * 0.070
    sand_b = mix(0.38, 0.62, ht) + (grain_fine - 0.46) * 0.032 + speck_light * 0.060

    vig = 1.0 - smoothstep(0.35, 1.35, hypot(nx * 0.85, ny * 0.72)) * 0.24
    pan_r = sand_r * vig
    pan_g = sand_g * vig
    pan_b = sand_b * vig

    # 4. Burnished bronze double border & corner suns
    bronze_r = 0.48
    bronze_g = 0.30
    bronze_b = 0.15
    b_outer = 1.0 - smoothstep(0.006, 0.015, abs(d_panel + 0.008))
    b_inner = 1.0 - smoothstep(0.003, 0.010, abs(d_panel + 0.048))

    cx = ax - 0.72
    cy = ay - 1.12
    cr = hypot(cx, cy)
    ca = atan2(cy, cx)
    c_sun = cr - (0.048 + 0.014 * cos(ca * 8.0))
    c_mark = 1.0 - smoothstep(-aa, aa, c_sun)

    trim = clamp(max(max(b_outer, b_inner * 0.85), c_mark * 0.85), 0.0, 1.0)
    pan_r = mix(pan_r, bronze_r, trim)
    pan_g = mix(pan_g, bronze_g, trim)
    pan_b = mix(pan_b, bronze_b, trim)

    # 5. Central compass-rose medallion
    r_c = hypot(nx, ny)
    ang = atan2(ny, nx)
    mrad = r_c / 0.38
    ring1 = 1.0 - smoothstep(0.015, 0.032, abs(mrad - 0.98))
    ring2 = 1.0 - smoothstep(0.010, 0.022, abs(mrad - 0.78))

    # 8-point compass star
    star_r = 0.26 * (0.45 + 0.55 * (abs(cos(ang * 4.0)) ** 3.0))
    in_star = 1.0 - smoothstep(-aa, aa, r_c - star_r)
    in_core = 1.0 - smoothstep(0.030, 0.040, r_c)

    in_disc = 1.0 - smoothstep(0.97, 1.01, mrad)
    pan_r = mix(pan_r, pan_r * 0.84, in_disc * 0.65)
    pan_g = mix(pan_g, pan_g * 0.82, in_disc * 0.65)
    pan_b = mix(pan_b, pan_b * 0.78, in_disc * 0.65)

    emblem = clamp(max(max(ring1, ring2 * 0.85), in_star), 0.0, 1.0)
    pan_r = mix(pan_r, bronze_r, emblem)
    pan_g = mix(pan_g, bronze_g, emblem)
    pan_b = mix(pan_b, bronze_b, emblem)
    pan_r = mix(pan_r, 0.96, in_core)
    pan_g = mix(pan_g, 0.86, in_core)
    pan_b = mix(pan_b, 0.64, in_core)

    out_r = clamp(mix(ivory_r, pan_r, in_panel), 0.0, 1.0)
    out_g = clamp(mix(ivory_g, pan_g, in_panel), 0.0, 1.0)
    out_b = clamp(mix(ivory_b, pan_b, in_panel), 0.0, 1.0)
    return [out_r, out_g, out_b]

def on_draw_card_back(ctx, w, h):
    ctx.apply_shader("rippled_sands_back_shader", intensity=1.0)
