# ==============================================================================
# SolEngine Foley Preset: Vintage Bicycle Paper (.eats)
# Abrasive grain, dry fiber bite, warm paper flexion
# ==============================================================================

def configure():
    audio.set_master_volume(0.85)
    audio.set_master_variance(1.0)

    audio.set_physical_params({
        velvet_density: 2200.0,
        edge_snap:      0.70,
        air_boost:      -1.5,
        comb_delay:     0.00026,
        felt_damping:   4800.0,
        card_rigidity:  2350.0
    })

sol.define_sound_pack({
    id: "vintage_bicycle",
    name: "Bicycle",
    configure: configure
})
