# =============================================================================
# SolEngine Game Family: Yukon (.eats)
# Consolidated variants:
#   - Yukon
#   - Russian Solitaire
# =============================================================================

# --- Shared Parameterized Yukon Rules ---

def yukon_eval():
    score = 0
    z = 0
    while z <= 3:
        score = score + zone_size(z) * 500
        z = z + 1
    z = 4
    while z <= 10:
        sz = zone_size(z)
        if sz == 0:
            score = score + 150
        else:
            fd = 0
            i = 0
            while i < sz:
                if not card_face_up(z, i):
                    fd = fd + 1
                i = i + 1
            score = score - fd * 200
            if fd > 0:
                score = score - (sz - fd) * 15
        z = z + 1
    return score

def yukon_can_pick(z, i):
    sz = zone_size(z)
    if z < 4 or z > 10 or sz == 0 or i < 0 or i >= sz:
        return False
    return card_face_up(z, i)

def yukon_can_drop(same_suit, from_z, i, to_z):
    if from_z == to_z or from_z < 4 or from_z > 10 or zone_size(from_z) == 0:
        return False
    sz = zone_size(from_z)
    r = card_rank(from_z, i)
    s = card_suit(from_z, i)
    red = card_is_red(from_z, i)

    if to_z >= 0 and to_z <= 3:
        if i != sz - 1:
            return False
        fsz = zone_size(to_z)
        if fsz == 0:
            return r == 1
        return card_suit(to_z, fsz - 1) == s and r == card_rank(to_z, fsz - 1) + 1

    if to_z >= 4 and to_z <= 10:
        tsz = zone_size(to_z)
        if tsz == 0:
            return r == 13
        if same_suit:
            return card_face_up(to_z, tsz - 1) and (card_suit(to_z, tsz - 1) == s) and (card_rank(to_z, tsz - 1) == r + 1)
        return card_face_up(to_z, tsz - 1) and (card_is_red(to_z, tsz - 1) != red) and (card_rank(to_z, tsz - 1) == r + 1)

    return False

def yukon_on_turn_end():
    z = 4
    while z <= 10:
        sz = zone_size(z)
        if sz > 0 and not card_face_up(z, sz - 1):
            flip_card(z, sz - 1, True)
        z = z + 1
    return True

def yukon_status():
    total = zone_size(0) + zone_size(1) + zone_size(2) + zone_size(3)
    if total == 52:
        return "victory"
    return "playing"

def yukon_drop_alt(fz, i, tz):
    return yukon_can_drop(False, fz, i, tz)

def yukon_drop_suit(fz, i, tz):
    return yukon_can_drop(True, fz, i, tz)

