# =============================================================================
# SolEngine Game Family: Pyramid (.eats)
# Consolidated variants:
#   - Pyramid
#   - Giza
# =============================================================================

# --- Shared Parameterized Pyramid (Pair-to-13) Rules ---

def pyr_is_uncovered(is_giza, z):
    if zone_size(z) == 0:
        return False
    if is_giza:
        if z >= 31 and z <= 38:
            return True
    else:
        if z == 0 or z == 1:
            return True
    if z < 3 or z > 30:
        return False
    idx = z - 3
    row = 0
    start = 0
    while start + row + 1 <= idx:
        start = start + row + 1
        row = row + 1
    if row == 6:
        return True
    col = idx - start
    lc = 3 + start + row + 1 + col
    return zone_size(lc) == 0 and zone_size(lc + 1) == 0

def pyr_remaining():
    rem = 0
    z = 3
    while z <= 30:
        if zone_size(z) > 0:
            rem = rem + 1
        z = z + 1
    return rem

def pyr_can_pick(is_giza, z, i):
    sz = zone_size(z)
    if sz == 0 or i != sz - 1:
        return False
    return pyr_is_uncovered(is_giza, z)

def pyr_can_drop(is_giza, from_z, i, to_z):
    if to_z != 2 or not pyr_can_pick(is_giza, from_z, i):
        return False
    return card_rank(from_z, i) == 13

def pyr_can_target(is_giza, fz, fi, tz, ti):
    if fz == tz:
        return False
    if not pyr_can_pick(is_giza, fz, fi) or not pyr_can_pick(is_giza, tz, ti):
        return False
    return card_rank(fz, fi) + card_rank(tz, ti) == 13

def pyr_on_target(is_giza, fz, fi, tz, ti):
    if not pyr_can_target(is_giza, fz, fi, tz, ti):
        return False
    move_cards(fz, fi, 2)
    move_cards(tz, ti, 2)
    add_score(20)
    return True

def pyr_on_click(is_giza, z, i):
    if pyr_can_pick(is_giza, z, i) and card_rank(z, i) == 13:
        move_cards(z, i, 2)
        add_score(10)
        return True
    return False

def pyr_status():
    if pyr_remaining() == 0:
        return "victory"
    return "playing"

# --- Pyramid Bindings ---
def pyramid_eval():
    return (28 - pyr_remaining()) * 120 - get_stat("REDEALS", 0) * 20

def pyramid_deal():
    set_stat("REDEALS", 0)
    return True

def pyramid_pick(z, i):
    return pyr_can_pick(False, z, i)

def pyramid_drop(fz, i, tz):
    return pyr_can_drop(False, fz, i, tz)

def pyramid_can_target(fz, fi, tz, ti):
    return pyr_can_target(False, fz, fi, tz, ti)

def pyramid_on_target(fz, fi, tz, ti):
    return pyr_on_target(False, fz, fi, tz, ti)

def pyramid_click(z, i):
    return pyr_on_click(False, z, i)

def pyramid_stock():
    if zone_size(0) > 0:
        top = zone_size(0) - 1
        move_cards(0, top, 1)
        flip_card(1, zone_size(1) - 1, True)
        return True
    if zone_size(1) > 0 and get_stat("REDEALS", 0) < 2:
        while zone_size(1) > 0:
            top = zone_size(1) - 1
            move_cards(1, top, 0)
            flip_card(0, zone_size(0) - 1, False)
        set_stat("REDEALS", get_stat("REDEALS", 0) + 1)
        return True
    return False

# --- Giza Bindings ---
def giza_eval():
    return (28 - pyr_remaining()) * 120

def giza_pick(z, i):
    return pyr_can_pick(True, z, i)

def giza_drop(fz, i, tz):
    return pyr_can_drop(True, fz, i, tz)

def giza_can_target(fz, fi, tz, ti):
    return pyr_can_target(True, fz, fi, tz, ti)

def giza_on_target(fz, fi, tz, ti):
    return pyr_on_target(True, fz, fi, tz, ti)

def giza_click(z, i):
    return pyr_on_click(True, z, i)

# =============================================================================
# Variant Definitions
# =============================================================================

