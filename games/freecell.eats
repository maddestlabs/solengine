# =============================================================================
# SolEngine Game Family: FreeCell (.eats)
# Consolidated variants:
#   - FreeCell
#   - Baker's Game
#   - Eight Off
#   - Seahaven Towers
#   - Penguin
# =============================================================================

# --- Shared Parameterized FreeCell Rules ---

def fc_eval(fc_end, f_start, f_end, t_start, t_end, same_suit, fc_wt, empty_wt, seq_wt):
    score = 0
    z = f_start
    while z <= f_end:
        score = score + zone_size(z) * 150
        z = z + 1
    z = 0
    while z <= fc_end:
        if zone_size(z) == 0:
            score = score + fc_wt
        z = z + 1
    z = t_start
    while z <= t_end:
        sz = zone_size(z)
        if sz == 0:
            score = score + empty_wt
        else:
            i = 0
            while i < sz - 1:
                match = False
                if same_suit:
                    match = card_suit(z, i) == card_suit(z, i + 1)
                else:
                    match = card_is_red(z, i) != card_is_red(z, i + 1)
                if match and card_rank(z, i) == card_rank(z, i + 1) + 1:
                    score = score + seq_wt
                i = i + 1
        z = z + 1
    return score

def fc_max_supermove(fc_end, t_start, t_end, exclude_z):
    empty_fc = 0
    f = 0
    while f <= fc_end:
        if zone_size(f) == 0:
            empty_fc = empty_fc + 1
        f = f + 1
    mult = 1
    t = t_start
    while t <= t_end:
        if t != exclude_z and zone_size(t) == 0:
            mult = mult * 2
        t = t + 1
    return (empty_fc + 1) * mult

def fc_can_pick(fc_end, t_start, t_end, same_suit, z, i):
    sz = zone_size(z)
    if sz == 0 or i < 0 or i >= sz:
        return False
    if z >= 0 and z <= fc_end:
        return i == sz - 1
    if z >= t_start and z <= t_end:
        if i == sz - 1:
            return True
        k = i
        while k < sz - 1:
            if same_suit:
                if card_suit(z, k) != card_suit(z, k + 1) or card_rank(z, k) != card_rank(z, k + 1) + 1:
                    return False
            else:
                if card_is_red(z, k) == card_is_red(z, k + 1) or card_rank(z, k) != card_rank(z, k + 1) + 1:
                    return False
            k = k + 1
        return (sz - i) <= fc_max_supermove(fc_end, t_start, t_end, -1)
    return False

def fc_can_drop(fc_end, f_start, f_end, t_start, t_end, same_suit, king_only, from_z, i, to_z):
    if from_z == to_z or zone_size(from_z) == 0:
        return False
    sz = zone_size(from_z)
    r = card_rank(from_z, i)
    s = card_suit(from_z, i)
    red = card_is_red(from_z, i)

    if to_z >= 0 and to_z <= fc_end:
        return i == sz - 1 and zone_size(to_z) == 0

    if to_z >= f_start and to_z <= f_end:
        if i != sz - 1:
            return False
        fsz = zone_size(to_z)
        if fsz == 0:
            return r == 1
        return card_suit(to_z, fsz - 1) == s and r == card_rank(to_z, fsz - 1) + 1

    if to_z >= t_start and to_z <= t_end:
        if (sz - i) > fc_max_supermove(fc_end, t_start, t_end, to_z):
            return False
        tsz = zone_size(to_z)
        if tsz == 0:
            if king_only:
                return r == 13
            return True
        if same_suit:
            return (card_suit(to_z, tsz - 1) == s) and (card_rank(to_z, tsz - 1) == r + 1)
        return (card_is_red(to_z, tsz - 1) != red) and (card_rank(to_z, tsz - 1) == r + 1)

    return False

def fc_status(f_start, f_end):
    total = 0
    z = f_start
    while z <= f_end:
        total = total + zone_size(z)
        z = z + 1
    if total == 52:
        return "victory"
    return "playing"

# --- FreeCell Bindings (4 cells: 0..3, 4 founds: 4..7, 8 tabs: 8..15, alt color, any empty) ---
def freecell_eval():
    return fc_eval(3, 4, 7, 8, 15, False, 25, 30, 20)

def freecell_pick(z, i):
    return fc_can_pick(3, 8, 15, False, z, i)

def freecell_drop(fz, i, tz):
    return fc_can_drop(3, 4, 7, 8, 15, False, False, fz, i, tz)

def fc4_status():
    return fc_status(4, 7)

# --- Baker's Game Bindings (4 cells: 0..3, 4 founds: 4..7, 8 tabs: 8..15, same suit, any empty) ---
def bakers_eval():
    return fc_eval(3, 4, 7, 8, 15, True, 20, 25, 25)

def bakers_pick(z, i):
    return fc_can_pick(3, 8, 15, True, z, i)

def bakers_drop(fz, i, tz):
    return fc_can_drop(3, 4, 7, 8, 15, True, False, fz, i, tz)

# --- Eight Off Bindings (8 cells: 0..7, 4 founds: 8..11, 8 tabs: 12..19, same suit, king empty) ---
def eight_off_eval():
    return fc_eval(7, 8, 11, 12, 19, True, 20, 20, 25)

def eight_off_pick(z, i):
    return fc_can_pick(7, 12, 19, True, z, i)

def eight_off_drop(fz, i, tz):
    return fc_can_drop(7, 8, 11, 12, 19, True, True, fz, i, tz)

def eight_off_status():
    return fc_status(8, 11)

# --- Seahaven Towers Bindings (4 cells: 0..3, 4 founds: 4..7, 10 tabs: 8..17, same suit, king empty) ---
def seahaven_eval():
    return fc_eval(3, 4, 7, 8, 17, True, 20, 20, 25)

def seahaven_pick(z, i):
    return fc_can_pick(3, 8, 17, True, z, i)

def seahaven_drop(fz, i, tz):
    return fc_can_drop(3, 4, 7, 8, 17, True, True, fz, i, tz)

