        ],
        zones: [
            { index: 0, name: "Flipper Cells (1-7)", desc: "7 temporary single-card holding cells." },
            { index: 7, name: "Foundations (1-4)", desc: "3 start pre-filled with BEAK_RANK; build up in suit wrapping K->A." },
            { index: 11, name: "Tableau Columns (1-7)", desc: "7 open columns of 7 cards. Build down in SAME SUIT wrapping A->K; ordered runs move together; empty spaces accept only the rank below BEAK_RANK." }
