# --- Penguin Rules (Parlett 1979) ---
# Zone Map:
#   0..6   : 7 Flipper Cells (FreeCells)
#   7..10  : 4 Foundations (3 pre-filled with BEAK_RANK, 1 empty)
#   11..17 : 7 Tableau Columns (7 cards each = 49 cards)

def penguin_rank_str(r):
    if r == 1:
        return "A"
    if r == 11:
        return "J"
    if r == 12:
        return "Q"
    if r == 13:
        return "K"
    return str(r)

def penguin_top_rank():
    beak = get_stat("BEAK_RANK", 1)
    return ((beak - 2 + 13) % 13) + 1

def penguin_refresh_badges():
    beak = get_stat("BEAK_RANK", 1)
    top_r = penguin_top_rank()
    set_zone_badge(10, "top", "BEAK: " + penguin_rank_str(beak), True)
    set_zone_badge(7, "top", "SPACE: " + penguin_rank_str(top_r), False)
    return True

def penguin_on_deal():
    # First card of column 11 is the "Beak" — sets the Foundation base rank
    beak_r = card_rank(11, 0)
    set_stat("BEAK_RANK", beak_r)

    # Extract the other 3 cards of rank beak_r onto Foundations 7..9
    f_zone = 7
    z = 11
    while z <= 17 and f_zone <= 9:
        i = zone_size(z) - 1
        while i >= 0 and f_zone <= 9:
            if not (z == 11 and i == 0):
                if card_rank(z, i) == beak_r:
                    extract_card(z, i, f_zone)
                    flip_card(f_zone, zone_size(f_zone) - 1, True)
                    f_zone = f_zone + 1
            i = i - 1
        z = z + 1

    # Rebalance columns 11..17 so every column starts with exactly 7 cards (49 total)
    src = 11
    while src <= 17:
        while zone_size(src) > 7:
            dst = 11
            moved = False
            while dst <= 17 and not moved:
                if zone_size(dst) < 7:
                    top = zone_size(src) - 1
                    move_cards(src, top, dst)
                    moved = True
                dst = dst + 1
            if not moved:
                break
        src = src + 1
    penguin_refresh_badges()
    return True

def penguin_eval():
    score = 0
    z = 7
    while z <= 10:
        score = score + zone_size(z) * 300
        z = z + 1
    z = 0
    while z <= 6:
        if zone_size(z) == 0:
            score = score + 14
        z = z + 1
    beak = get_stat("BEAK_RANK", 1)
    z = 11
    while z <= 17:
        sz = zone_size(z)
        if sz == 0:
            score = score + 35
        else:
            i = 0
            while i < sz:
                r = card_rank(z, i)
                rel = (r - beak + 13) % 13
                above = (sz - 1) - i
                # Penalize burying low-relative-rank cards (next needed on foundations)
                if rel <= 3 and above > 0:
                    score = score - above * (5 - rel) * 10
                if i < sz - 1:
                    r_lo = card_rank(z, i + 1)
                    if card_suit(z, i) == card_suit(z, i + 1) and r != beak and r == ((r_lo % 13) + 1):
                        score = score + 28
                i = i + 1
        z = z + 1
    return score

def penguin_pick(z, i):
    sz = zone_size(z)
    if sz == 0 or i < 0 or i >= sz:
        return False
    if z >= 0 and z <= 6:
        return i == sz - 1
    if z >= 11 and z <= 17:
        if i == sz - 1:
            return True
        beak = get_stat("BEAK_RANK", 1)
        k = i
        while k < sz - 1:
            r_hi = card_rank(z, k)
            r_lo = card_rank(z, k + 1)
            if card_suit(z, k) != card_suit(z, k + 1) or r_hi == beak or r_hi != ((r_lo % 13) + 1):
                return False
            k = k + 1
        return True
    return False

def penguin_drop(from_z, i, to_z):
    if from_z == to_z or zone_size(from_z) == 0:
        return False
    sz = zone_size(from_z)
    r = card_rank(from_z, i)
    s = card_suit(from_z, i)
    beak = get_stat("BEAK_RANK", 1)

    if to_z >= 0 and to_z <= 6:
        return i == sz - 1 and zone_size(to_z) == 0

    if to_z >= 7 and to_z <= 10:
        if i != sz - 1:
            return False
        fsz = zone_size(to_z)
        if fsz == 0:
            return r == beak
        if fsz >= 13:
            return False
        next_r = (card_rank(to_z, fsz - 1) % 13) + 1
        return card_suit(to_z, fsz - 1) == s and r == next_r

    if to_z >= 11 and to_z <= 17:
        tsz = zone_size(to_z)
        if tsz == 0:
            return r == penguin_top_rank()
        top_r = card_rank(to_z, tsz - 1)
        if top_r == beak:
            return False
        return card_suit(to_z, tsz - 1) == s and top_r == ((r % 13) + 1)

    return False

def penguin_status():
    return fc_status(7, 10)

