# =============================================================================
# SolEngine Game Variant: FreeCell (.eats)
# =============================================================================
# Open tableau game of pure skill with 4 reserve FreeCells.

# --- Unified Help & Introspection Manifest ---
doc_meta(3, "Medium", 1, "Pure Skill", 4, "Strategic")
doc_aliases(["Baker's Alternating", "Eight-Column FreeCell"])
doc_goal("Build all 4 Foundations up in suit from Ace to King.", "No legal moves remain.")
doc_zone(0, "FreeCells (1-4)", "4 temporary single-card holding cells.", [], ["Each cell holds any 1 card at a time."])
doc_zone(4, "Foundations (1-4)", "Build up by same suit from Ace to King.", ["AS", "2S", "3S"])
doc_zone(8, "Tableau Columns (1-8)", "Build down in alternating colors; any card may fill an empty column.", ["KH", "QS", "JD"])

def eval_heuristic():
    score = 0
    z = 4
    while z <= 7:
        score = score + zone_size(z) * 150
        z = z + 1
    z = 0
    while z <= 3:
        if zone_size(z) == 0:
            score = score + 25
        z = z + 1
    z = 8
    while z <= 15:
        sz = zone_size(z)
        if sz == 0:
            score = score + 30
        else:
            i = 0
            while i < sz - 1:
                if card_is_red(z, i) != card_is_red(z, i + 1) and card_rank(z, i) == card_rank(z, i + 1) + 1:
                    score = score + 20
                i = i + 1
        z = z + 1
    return score

def can_pick(z, i):
    sz = zone_size(z)
    if sz == 0 or i < 0 or i >= sz:
        return False
    if z >= 0 and z <= 3:
        return i == sz - 1
    if z >= 8 and z <= 15:
        if i == sz - 1:
            return True
        # Allow ordered alternating sequence if enough empty freecells/columns
        k = i
        while k < sz - 1:
            if card_is_red(z, k) == card_is_red(z, k + 1) or card_rank(z, k) != card_rank(z, k + 1) + 1:
                return False
            k = k + 1
        return (sz - i) <= max_supermove(-1)
    return False

def max_supermove(exclude_z):
    empty_fc = 0
    f = 0
    while f <= 3:
        if zone_size(f) == 0:
            empty_fc = empty_fc + 1
        f = f + 1
    mult = 1
    t = 8
    while t <= 15:
        if t != exclude_z and zone_size(t) == 0:
            mult = mult * 2
        t = t + 1
    return (empty_fc + 1) * mult

def can_drop(from_z, i, to_z):
    if from_z == to_z or zone_size(from_z) == 0:
        return False
    sz = zone_size(from_z)
    r = card_rank(from_z, i)
    s = card_suit(from_z, i)
    red = card_is_red(from_z, i)

    if to_z >= 0 and to_z <= 3:
        return i == sz - 1 and zone_size(to_z) == 0

    if to_z >= 4 and to_z <= 7:
        if i != sz - 1:
            return False
        fsz = zone_size(to_z)
        if fsz == 0:
            return r == 1
        return card_suit(to_z, fsz - 1) == s and r == card_rank(to_z, fsz - 1) + 1

    if to_z >= 8 and to_z <= 15:
        if (sz - i) > max_supermove(to_z):
            return False
        tsz = zone_size(to_z)
        if tsz == 0:
            return True
        return (card_is_red(to_z, tsz - 1) != red) and (card_rank(to_z, tsz - 1) == r + 1)

    return False

def get_status():
    total = zone_size(4) + zone_size(5) + zone_size(6) + zone_size(7)
    if total == 52:
        return "victory"
    return "playing"

sol.define_game({
    id: "freecell",
    name: "FreeCell",
    family: "FreeCell",
    category: "FREECELL",
    layout: "columns",
    description: "Open tableau game of skill. 4 reserve free cells; nearly every deal is winnable.",
    decks: 1,
    tableaus: 8,
    foundations: 4,
    freecells: 4,
    tableau_deal_counts: [7, 7, 7, 7, 6, 6, 6, 6],
    tableau_all_face_up: True,
    foundation_starter_card: False,
    stock_deal_mode: "none",
    stock_deal_count: 0,
    max_redeals: 0,
    demo_seed: 2,
    demo_seeds: [2, 17, 18, 21, 25, 29, 41, 45],
    eval_heuristic: eval_heuristic,
    can_pick: can_pick,
    can_drop: can_drop,
    get_status: get_status
})
