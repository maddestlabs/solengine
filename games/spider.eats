# =============================================================================
# SolEngine Game Family: Spider (.eats)
# Consolidated variants: Spider (1 Suit), Spider (2 Suits), Spider (4 Suits), Spiderette
# =============================================================================

# --- Shared Parameterized Spider Rules ---

def spider_eval(f_end, t_start, t_end, f_wt, empty_wt, hidden_pen, suit_wt):
    score = 0
    z = 1
    while z <= f_end:
        if zone_size(z) > 0:
            score = score + f_wt
        z = z + 1
    z = t_start
    while z <= t_end:
        sz = zone_size(z)
        if sz == 0:
            score = score + empty_wt
        i = 0
        while i < sz:
            if not card_face_up(z, i):
                score = score - hidden_pen
            elif i < sz - 1 and card_face_up(z, i + 1) and card_rank(z, i) == card_rank(z, i + 1) + 1:
                if card_suit(z, i) == card_suit(z, i + 1):
                    score = score + suit_wt
                else:
                    score = score + 5
            i = i + 1
        z = z + 1
    return score

def spider_can_pick(t_start, t_end, z, i):
    sz = zone_size(z)
    if z < t_start or z > t_end or sz == 0 or i < 0 or i >= sz:
        return False
    if not card_face_up(z, i):
        return False
    k = i
    while k < sz - 1:
        if card_suit(z, k) != card_suit(z, k + 1) or card_rank(z, k) != card_rank(z, k + 1) + 1:
            return False
        k = k + 1
    return True

def spider_can_drop(t_start, t_end, from_z, i, to_z):
    if from_z == to_z or from_z < t_start or from_z > t_end or to_z < t_start or to_z > t_end:
        return False
    if zone_size(from_z) == 0:
        return False
    tsz = zone_size(to_z)
    if tsz == 0:
        return True
    return card_face_up(to_z, tsz - 1) and card_rank(to_z, tsz - 1) == card_rank(from_z, i) + 1

def spider_on_stock(t_start, t_end):
    if zone_size(0) == 0:
        return False
    z = t_start
    while z <= t_end:
        if zone_size(z) == 0:
            return False
        z = z + 1
    z = t_start
    while z <= t_end and zone_size(0) > 0:
        top = zone_size(0) - 1
        move_cards(0, top, z)
        flip_card(z, zone_size(z) - 1, True)
        z = z + 1
    return True

def spider_on_turn_end(f_end, t_start, t_end):
    z = t_start
    while z <= t_end:
        sz = zone_size(z)
        if sz >= 13:
            start = sz - 13
            ok = True
            s0 = card_suit(z, start)
            k = 0
            while k < 13:
                idx = start + k
                if not card_face_up(z, idx) or card_suit(z, idx) != s0 or card_rank(z, idx) != 13 - k:
                    ok = False
                k = k + 1
            if ok:
                f = 1
                while f <= f_end:
                    if zone_size(f) == 0:
                        move_cards(z, start, f)
                        add_score(100)
                        f = 99
                    f = f + 1
        z = z + 1
    z = t_start
    while z <= t_end:
        sz = zone_size(z)
        if sz > 0 and not card_face_up(z, sz - 1):
            flip_card(z, sz - 1, True)
        z = z + 1
    return True

def spider_status(f_end):
    f = 1
    done = 0
    while f <= f_end:
        if zone_size(f) >= 13:
            done = done + 1
        f = f + 1
    if done == f_end:
        return "victory"
    return "playing"

# --- 10-Column Spider Bindings (1, 2, 4 Suits) ---
def s12_eval():
    return spider_eval(8, 9, 18, 1000, 40, 15, 25)

def s4_eval():
    return spider_eval(8, 9, 18, 1500, 80, 25, 45)

def s10_can_pick(z, i):
    return spider_can_pick(9, 18, z, i)

def s10_can_drop(from_z, i, to_z):
    return spider_can_drop(9, 18, from_z, i, to_z)

def s10_on_stock():
    return spider_on_stock(9, 18)

def s10_on_turn_end():
    return spider_on_turn_end(8, 9, 18)

def s10_status():
    return spider_status(8)

# --- 7-Column Spiderette Bindings ---
def sp_eval():
    return spider_eval(4, 5, 11, 1000, 40, 15, 25)

def sp_can_pick(z, i):
    return spider_can_pick(5, 11, z, i)

def sp_can_drop(from_z, i, to_z):
    return spider_can_drop(5, 11, from_z, i, to_z)

def sp_on_stock():
    return spider_on_stock(5, 11)

def sp_on_turn_end():
    return spider_on_turn_end(4, 5, 11)

def sp_status():
    return spider_status(4)

# --- Variant Definitions ---

