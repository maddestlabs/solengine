    stock_deal_mode: "deal_to_all_columns",
    stock_deal_count: 10,
    demo_seed: 5,
    demo_seeds: [5, 9, 10, 13, 21, 29, 30, 33],
    eval_heuristic: s12_eval,
    can_pick: s10_can_pick,
    can_drop: s10_can_drop,
    on_stock_click: s10_on_stock,
    on_turn_end: s10_on_turn_end,
    get_status: s10_status,
    doc: {
        meta: [3, "Medium", 1, "Low Luck", 2, "Casual"],
        aliases: ["One-Suit Spider"],
        goal: ["Assemble 8 complete King-to-Ace runs of Spades to clear the board.", "No legal moves remain."],
        zones: [
            { index: 0, name: "Stock", desc: "Click to deal 1 card to each of the 10 Tableau columns (all columns must be non-empty)." },
            { index: 1, name: "Foundations (1-8)", desc: "Completed King-to-Ace runs automatically move here." },
            { index: 9, name: "Tableau Columns (1-10)", desc: "Build down in rank; same-suit sequences move together; any card fills empty columns." }
        ]
    }
})

