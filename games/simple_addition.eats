# =============================================================================
# SolEngine Game Family: Simple Addition (.eats)
# Consolidated variants:
#   - Block Ten (3x3 Sum-to-10 with Permanent Ten Blockers)
#   - Elevens (3x3 Sum-to-11 & J-Q-K Triples)
#   - Thirteens (5x2 Sum-to-13 & Solo Kings)
#   - Fourteens (12 Open Columns Sum-to-14)
# =============================================================================

# --- Shared Simple Addition Helpers ---

def sa_refill(max_z, stock_z):
    z = 1
    while z <= max_z and zone_size(stock_z) > 0:
        if zone_size(z) == 0:
            top = zone_size(stock_z) - 1
            move_cards(stock_z, top, z)
            flip_card(z, 0, True)
        z = z + 1
    return True

def sa_eval():
    return zone_size(0) * 120

def sa_can_pick(max_z, z, i):
    if z < 1 or z > max_z or zone_size(z) == 0:
        return False
    return i == zone_size(z) - 1

def sa_clear_pair(fz, fi, tz, ti, max_z, stock_z):
    move_cards(fz, fi, 0)
    move_cards(tz, ti, 0)
    if stock_z > 0:
        sa_refill(max_z, stock_z)
    add_score(20)
    return True

def sa_find_rank(max_z, target_rank):
    z = 1
    while z <= max_z:
        if zone_size(z) > 0 and card_rank(z, 0) == target_rank:
            return z
        z = z + 1
    return 0

def sa_no_drop(fz, i, tz):
    return False

def sa_status_52():
    if zone_size(0) >= 52:
        return "victory"
    return "playing"

def sa_status_48():
    if zone_size(0) >= 48:
        return "victory"
    return "playing"

# =============================================================================
# 1. Block Ten (3x3 Grid: Zones 1..9, Stock 10; 10s are permanent blockers)
# =============================================================================

def bt_pick(z, i):
    if not sa_can_pick(9, z, i):
        return False
    return card_rank(z, i) != 10

def bt_can_target(fz, fi, tz, ti):
    if fz == tz or not bt_pick(fz, fi) or not bt_pick(tz, ti):
        return False
    r1 = card_rank(fz, fi)
    r2 = card_rank(tz, ti)
    if r1 >= 11 and r2 >= 11:
        return r1 == r2
    if r1 <= 9 and r2 <= 9:
        return r1 + r2 == 10
    return False

def bt_on_target(fz, fi, tz, ti):
    if not bt_can_target(fz, fi, tz, ti):
        return False
    return sa_clear_pair(fz, fi, tz, ti, 9, 10)

def bt_turn_end():
    return sa_refill(9, 10)

# =============================================================================
# 2. Elevens (3x3 Grid: Zones 1..9, Stock 10; Sum-to-11 + J-Q-K Triple)
# =============================================================================

def el_pick(z, i):
    return sa_can_pick(9, z, i)

def el_has_jqk():
    return sa_find_rank(9, 11) > 0 and sa_find_rank(9, 12) > 0 and sa_find_rank(9, 13) > 0

def el_clear_jqk():
    jz = sa_find_rank(9, 11)
    qz = sa_find_rank(9, 12)
    kz = sa_find_rank(9, 13)
    if jz == 0 or qz == 0 or kz == 0:
        return False
    move_cards(jz, 0, 0)
    move_cards(qz, 0, 0)
    move_cards(kz, 0, 0)
    sa_refill(9, 10)
    add_score(30)
    return True

def el_can_target(fz, fi, tz, ti):
    if fz == tz or not el_pick(fz, fi) or not el_pick(tz, ti):
        return False
    r1 = card_rank(fz, fi)
    r2 = card_rank(tz, ti)
    if r1 <= 10 and r2 <= 10:
        return r1 + r2 == 11
    if r1 >= 11 and r2 >= 11 and r1 != r2:
        return el_has_jqk()
    return False

def el_on_target(fz, fi, tz, ti):
    if not el_can_target(fz, fi, tz, ti):
        return False
    r1 = card_rank(fz, fi)
    if r1 >= 11:
        return el_clear_jqk()
    return sa_clear_pair(fz, fi, tz, ti, 9, 10)

def el_click(z, i):
    if el_pick(z, i) and card_rank(z, i) >= 11 and el_has_jqk():
        return el_clear_jqk()
    return False

def el_turn_end():
    return sa_refill(9, 10)

# =============================================================================
# 3. Thirteens / Simple Addition (5x2 Grid: Zones 1..10, Stock 11)
# =============================================================================

def th_pick(z, i):
    return sa_can_pick(10, z, i)

def th_can_drop(fz, i, tz):
    if tz != 0 or not th_pick(fz, i):
        return False
    return card_rank(fz, i) == 13

def th_on_drop(fz, i, tz):
    if not th_can_drop(fz, i, tz):
        return False
    move_cards(fz, i, 0)
    sa_refill(10, 11)
    add_score(10)
    return True

def th_can_target(fz, fi, tz, ti):
    if fz == tz or not th_pick(fz, fi) or not th_pick(tz, ti):
        return False
    return card_rank(fz, fi) + card_rank(tz, ti) == 13

def th_on_target(fz, fi, tz, ti):
    if not th_can_target(fz, fi, tz, ti):
        return False
    return sa_clear_pair(fz, fi, tz, ti, 10, 11)

def th_click(z, i):
    if th_pick(z, i) and card_rank(z, i) == 13:
        move_cards(z, i, 0)
        sa_refill(10, 11)
        add_score(10)
        return True
    return False

def th_turn_end():
    return sa_refill(10, 11)

# =============================================================================
# 4. Fourteens (12 Open Columns: Zone 2 = Discard, Zones 3..14 = Columns, Sum 14)
# =============================================================================

def f14_eval():
    sum_sq = 0
    z = 3
    while z <= 14:
        sz = zone_size(z)
        sum_sq = sum_sq + sz * sz
        z = z + 1
    pairs = 0
    a = 3
    while a <= 14:
        sza = zone_size(a)
        if sza > 0:
            ra = card_rank(a, sza - 1)
            b = a + 1
            while b <= 14:
                szb = zone_size(b)
                if szb > 0 and ra + card_rank(b, szb - 1) == 14:
                    pairs = pairs + 1
                b = b + 1
        a = a + 1
    return zone_size(2) * 160 - sum_sq * 18 + pairs * 35

def f14_pick(z, i):
    if z < 3 or z > 14 or zone_size(z) == 0:
        return False
    return i == zone_size(z) - 1

def f14_can_target(fz, fi, tz, ti):
    if fz == tz or not f14_pick(fz, fi) or not f14_pick(tz, ti):
        return False
    return card_rank(fz, fi) + card_rank(tz, ti) == 14

def f14_on_target(fz, fi, tz, ti):
    if not f14_can_target(fz, fi, tz, ti):
        return False
    move_cards(fz, fi, 2)
    move_cards(tz, ti, 2)
    add_score(20)
    return True

def f14_status():
    if zone_size(2) >= 52:
        return "victory"
    return "playing"

