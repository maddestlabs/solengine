# =============================================================================
# SolEngine Game Family: Golf (.eats)
# Consolidated variants: Golf, TriPeaks, Clockwork Dial
# =============================================================================

# --- Shared Parameterized Golf Rules ---

def golf_eval(t_start, t_end, total_cards, stock_z):
    rem = 0
    z = t_start
    while z <= t_end:
        rem = rem + zone_size(z)
        z = z + 1
    return (total_cards - rem) * 100 + zone_size(stock_z) * 10

def golf_on_deal(stock_z, found_z):
    if zone_size(found_z) == 0 and zone_size(stock_z) > 0:
        top = zone_size(stock_z) - 1
        move_cards(stock_z, top, found_z)
        flip_card(found_z, 0, True)
    return True

def golf_can_pick(t_start, t_end, check_face_up, check_blocked, z, i):
    sz = zone_size(z)
    if z < t_start or z > t_end or sz == 0 or i != sz - 1:
        return False
    if check_face_up and not card_face_up(z, i):
        return False
    if check_blocked and is_card_blocked(z, i):
        return False
    return True

def golf_can_drop(t_start, t_end, found_z, wrap_king_ace, allow_on_king, check_face_up, check_blocked, from_z, i, to_z):
    if to_z != found_z or from_z < t_start or from_z > t_end:
        return False
    if not golf_can_pick(t_start, t_end, check_face_up, check_blocked, from_z, i):
        return False
    fsz = zone_size(found_z)
    if fsz == 0:
        return True
    fr = card_rank(found_z, fsz - 1)
    if not allow_on_king and fr == 13:
        return False
    mr = card_rank(from_z, i)
    if mr == fr + 1 or mr == fr - 1:
        return True
    if wrap_king_ace and ((fr == 13 and mr == 1) or (fr == 1 and mr == 13)):
        return True
    return False

def golf_on_stock(stock_z, found_z):
    if zone_size(stock_z) == 0:
        return False
    top = zone_size(stock_z) - 1
    move_cards(stock_z, top, found_z)
    flip_card(found_z, zone_size(found_z) - 1, True)
    return True

def golf_status(t_start, t_end):
    rem = 0
    z = t_start
    while z <= t_end:
        rem = rem + zone_size(z)
        z = z + 1
    if rem == 0:
        return "victory"
    return "playing"

# --- Golf (7-Column Classic) Bindings ---
def g_eval():
    return golf_eval(2, 8, 35, 0)

def g_deal():
    return golf_on_deal(0, 1)

def g_pick(z, i):
    return golf_can_pick(2, 8, False, False, z, i)

def g_drop(from_z, i, to_z):
    return golf_can_drop(2, 8, 1, False, False, False, False, from_z, i, to_z)

def g_click(z, i):
    if not g_drop(z, i, 1):
        return False
    move_cards(z, i, 1)
    add_score(10)
    return True

def g_stock():
    return golf_on_stock(0, 1)

def g_status():
    return golf_status(2, 8)

# --- TriPeaks Bindings ---
def tp_eval():
    return golf_eval(2, 29, 28, 0)

def tp_deal():
    return golf_on_deal(0, 1)

def tp_pick(z, i):
    return golf_can_pick(2, 29, True, True, z, i)

def tp_drop(from_z, i, to_z):
    return golf_can_drop(2, 29, 1, True, True, True, True, from_z, i, to_z)

def tp_click(z, i):
    if not tp_drop(z, i, 1):
        return False
    move_cards(z, i, 1)
    add_score(10)
    return True

def tp_stock():
    return golf_on_stock(0, 1)

def tp_turn_end():
    z = 2
    while z <= 29:
        sz = zone_size(z)
        if sz > 0 and not card_face_up(z, sz - 1) and not is_card_blocked(z, sz - 1):
            flip_card(z, sz - 1, True)
        z = z + 1
    return True

def tp_status():
    return golf_status(2, 29)

# --- Clockwork Dial Bindings ---
def cd_eval():
    rem = 0
    z = 0
    while z <= 11:
        rem = rem + zone_size(z)
        z = z + 1
    return (36 - rem) * 100 + zone_size(13) * 15

def cd_deal():
    return golf_on_deal(13, 12)

def cd_pick(z, i):
    return golf_can_pick(0, 11, True, False, z, i)

def cd_drop(from_z, i, to_z):
    return golf_can_drop(0, 11, 12, True, True, True, False, from_z, i, to_z)

def cd_click(z, i):
    if not cd_drop(z, i, 12):
        return False
    move_cards(z, i, 12)
    add_score(10)
    return True

def cd_stock():
    return golf_on_stock(13, 12)

def cd_turn_end():
    z = 0
    while z <= 11:
        sz = zone_size(z)
        if sz > 0 and not card_face_up(z, sz - 1):
            flip_card(z, sz - 1, True)
        z = z + 1
    return True

def cd_status():
    return golf_status(0, 11)

# --- Variant Definitions ---

sol.define_game({
    id: "golf",
    name: "Golf",
    family: "Golf",
    category: "GOLF",
    layout: "columns",
    description: "Fast-paced elimination solitaire. Stack cards +-1 rank onto foundation waste; Kings are dead ends.",
    decks: 1,
    tableaus: 7,
    foundations: 1,
    freecells: 0,
    tableau_deal_counts: [5, 5, 5, 5, 5, 5, 5],
    tableau_all_face_up: True,
    foundation_starter_card: True,
    stock_deal_mode: "deal_to_foundation",
    stock_deal_count: 1,
    max_redeals: 0,
    demo_seed: 16,
    demo_seeds: [16, 28, 40, 44, 45, 82, 141, 145],
    eval_heuristic: g_eval,
    on_deal: g_deal,
    can_pick: g_pick,
    can_drop: g_drop,
    on_card_click: g_click,
    on_stock_click: g_stock,
    get_status: g_status,
    doc: {
        meta: [1, "Fast", 4, "High Luck", 2, "Casual"],
        aliases: ["Golf Patience"],
        goal: ["Clear all 7 tableau columns onto the Foundation.", "No playable cards remain and Stock is empty."],
        zones: [
            { index: 0, name: "Stock", desc: "Remaining face-down cards. Click to deal a new card onto the Foundation." },
            { index: 1, name: "Foundation", desc: "Build +-1 in rank regardless of suit. Kings are dead ends.", examples: ["5H", "6S", "5D"] },
            { index: 2, name: "Tableau Columns (1-7)", desc: "Click or drag exposed top cards that are +-1 rank from the Foundation.", examples: ["7C", "4D"] }
        ]
    }
})

