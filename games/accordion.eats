            { index: 1, name: "Card Ribbon", desc: "Click any 1 or 2 cards sandwiched between two matching-suit or matching-rank cards to discard them (or drag the right card onto the left match). Never discard Q♥ or K♥.", examples: ["QH", "7S", "3D", "KH"] }
        ]
    }
})

