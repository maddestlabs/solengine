# =============================================================================
# SolEngine Game Variant: La Belle Lucie (.eats)
# =============================================================================
# The premier Fan solitaire. 18 fans (17 of 3 cards, 1 of 1 card) dealt face up.
# Build down in the same suit; single card movement; empty fans cannot be filled.

name = "La Belle Lucie"
family = "Fan"
category = "FREECELL"
layout = "fan_grid"
description = "18 fans of cards. Build down in suit; only top cards can move; spaces cannot be filled."
decks = 1
tableaus = 18
foundations = 4
freecells = 0

tableau_deal_counts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 1]
tableau_all_face_up = True
foundation_starter_card = False

stock_deal_mode = "none"
max_redeals = 2
demo_seed = 8

# --- Unified Help & Introspection Manifest ---
doc_meta(2, "Quick", 3, "Moderate", 4, "Tactical")
doc_aliases(["Three Shuffles and a Draw", "Clover Leaf"])
doc_goal("Build all 4 Foundations up in suit from Ace to King.", "No legal moves remain.")
doc_zone(0, "Foundations (1-4)", "Build up by same suit from Ace to King.", ["AS", "2S", "3S"])
doc_zone(4, "Fans (1-18)", "Build down in the SAME SUIT; only the top card may move; empty fans cannot be filled.", ["KS", "QS", "JS"])

def eval_heuristic():
    score = 0
    z = 0
    while z <= 3:
        score = score + zone_size(z) * 150
        z = z + 1
    z = 4
    while z <= 21:
        sz = zone_size(z)
        i = 0
        while i < sz - 1:
            if card_suit(z, i) == card_suit(z, i + 1) and card_rank(z, i) == card_rank(z, i + 1) + 1:
                score = score + 20
            i = i + 1
        z = z + 1
    return score

def can_pick(z, i):
    sz = zone_size(z)
    if z < 4 or z > 21 or sz == 0:
        return False
    return i == sz - 1

def can_drop(from_z, i, to_z):
    if from_z == to_z or zone_size(from_z) == 0:
        return False
    if i != zone_size(from_z) - 1:
        return False
    r = card_rank(from_z, i)
    s = card_suit(from_z, i)

    if to_z >= 0 and to_z <= 3:
        fsz = zone_size(to_z)
        if fsz == 0:
            return r == 1
        return card_suit(to_z, fsz - 1) == s and r == card_rank(to_z, fsz - 1) + 1

    if to_z >= 4 and to_z <= 21:
        tsz = zone_size(to_z)
        if tsz == 0:
            return False
        return card_suit(to_z, tsz - 1) == s and card_rank(to_z, tsz - 1) == r + 1

    return False

def get_status():
    total = zone_size(0) + zone_size(1) + zone_size(2) + zone_size(3)
    if total == 52:
        return "victory"
    return "playing"
