# =============================================================================
# SolEngine Game Variant: Klondike (Draw 1) (.eats)
# =============================================================================
name = "Klondike (Draw 1)"
family = "Klondike"
category = "KLONDIKE"
layout = "columns"
description = "The classic solitaire. Build down in alternating colors; single card draws to waste."
decks = 1
tableaus = 7
foundations = 4
freecells = 0
tableau_deal_counts = [1, 2, 3, 4, 5, 6, 7]
tableau_all_face_up = False
foundation_starter_card = False
stock_deal_mode = "waste_draw_1"
stock_deal_count = 1
max_redeals = -1
demo_seed = 2
demo_seeds = [2, 9, 25, 26, 33, 37, 41, 42]

# --- Unified Help & Introspection Manifest ---
doc_meta(2, "Quick", 3, "Moderate", 2, "Casual")
doc_aliases(["Classic Solitaire", "Patience"])
doc_goal("Build all 4 Foundations up in suit from Ace to King.", "No legal moves remain.")
doc_zone(0, "Stock", "Click to turn 1 card into the Waste; click when empty to recycle Waste.")
doc_zone(1, "Waste", "Top card is available to play onto Foundations or Tableau.")
doc_zone(2, "Foundations (1-4)", "Build up by same suit from Ace to King.", ["AS", "2S", "3S"])
doc_zone(6, "Tableau Columns (1-7)", "Build down in alternating colors; Kings only fill empty columns.", ["KH", "QS", "JD"])

def eval_heuristic():
    score = 0
    z = 2
    while z <= 5:
        score = score + zone_size(z) * 120
        z = z + 1
    z = 6
    while z <= 12:
        sz = zone_size(z)
        i = 0
        while i < sz:
            if not card_face_up(z, i):
                score = score - 25
            i = i + 1
        z = z + 1
    return score

def can_pick(z, i):
    sz = zone_size(z)
    if sz == 0 or i < 0 or i >= sz:
        return False
    if z == 1:
        return i == sz - 1
    if z >= 6 and z <= 12:
        return card_face_up(z, i)
    return False

def can_drop(from_z, i, to_z):
    if from_z == to_z or zone_size(from_z) == 0:
        return False
    sz = zone_size(from_z)
    r = card_rank(from_z, i)
    s = card_suit(from_z, i)
    red = card_is_red(from_z, i)

    if to_z >= 2 and to_z <= 5:
        if i != sz - 1:
            return False
        fsz = zone_size(to_z)
        if fsz == 0:
            return r == 1
        return card_suit(to_z, fsz - 1) == s and r == card_rank(to_z, fsz - 1) + 1

    if to_z >= 6 and to_z <= 12:
        tsz = zone_size(to_z)
        if tsz == 0:
            return r == 13
        return card_face_up(to_z, tsz - 1) and (card_is_red(to_z, tsz - 1) != red) and (card_rank(to_z, tsz - 1) == r + 1)

    return False

def on_stock_click():
    if zone_size(0) > 0:
        top = zone_size(0) - 1
        move_cards(0, top, 1)
        flip_card(1, zone_size(1) - 1, True)
        return True
    if zone_size(1) > 0:
        while zone_size(1) > 0:
            top = zone_size(1) - 1
            move_cards(1, top, 0)
            flip_card(0, zone_size(0) - 1, False)
        return True
    return False

def on_turn_end():
    z = 6
    while z <= 12:
        sz = zone_size(z)
        if sz > 0 and not card_face_up(z, sz - 1):
            flip_card(z, sz - 1, True)
        z = z + 1
    return True

def get_status():
    total = zone_size(2) + zone_size(3) + zone_size(4) + zone_size(5)
    if total == 52:
        return "victory"
    return "playing"
