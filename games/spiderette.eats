# =============================================================================
# SolEngine Game Variant: Spiderette (.eats)
# =============================================================================
name = "Spiderette"
family = "Spider"
category = "SPIDER"
layout = "columns"
description = "Compact 1-deck Spider on a 7-column Klondike deal. Build descending suit runs from King to Ace."
decks = 1
tableaus = 7
foundations = 4
freecells = 0
tableau_deal_counts = [1, 2, 3, 4, 5, 6, 7]
tableau_all_face_up = False
foundation_starter_card = False
stock_deal_mode = "deal_to_all_columns"
stock_deal_count = 7
max_redeals = 0
demo_seed = 137

# --- Unified Help & Introspection Manifest ---
doc_meta(2, "Quick", 3, "Moderate", 3, "Tactical")
doc_aliases(["Mini Spider"])
doc_goal("Assemble 4 complete King-to-Ace same-suit runs to clear the board.", "No legal moves remain.")
doc_zone(0, "Stock", "Click to deal 1 card to each of the 7 Tableau columns (all columns must be non-empty).")
doc_zone(1, "Foundations (1-4)", "Completed King-to-Ace same-suit runs automatically move here.")
doc_zone(5, "Tableau Columns (1-7)", "Build down in rank; same-suit sequences move together; any card fills empty columns.")

def eval_heuristic():
    score = 0
    z = 1
    while z <= 4:
        if zone_size(z) > 0:
            score = score + 1000
        z = z + 1
    z = 5
    while z <= 11:
        sz = zone_size(z)
        if sz == 0:
            score = score + 40
        i = 0
        while i < sz:
            if not card_face_up(z, i):
                score = score - 15
            elif i < sz - 1 and card_face_up(z, i + 1) and card_rank(z, i) == card_rank(z, i + 1) + 1:
                if card_suit(z, i) == card_suit(z, i + 1):
                    score = score + 25
                else:
                    score = score + 5
            i = i + 1
        z = z + 1
    return score

def can_pick(z, i):
    sz = zone_size(z)
    if z < 5 or z > 11 or sz == 0 or i < 0 or i >= sz:
        return False
    if not card_face_up(z, i):
        return False
    k = i
    while k < sz - 1:
        if card_suit(z, k) != card_suit(z, k + 1) or card_rank(z, k) != card_rank(z, k + 1) + 1:
            return False
        k = k + 1
    return True

def can_drop(from_z, i, to_z):
    if from_z == to_z or from_z < 5 or from_z > 11 or to_z < 5 or to_z > 11:
        return False
    if zone_size(from_z) == 0:
        return False
    tsz = zone_size(to_z)
    if tsz == 0:
        return True
    return card_rank(to_z, tsz - 1) == card_rank(from_z, i) + 1

def on_stock_click():
    if zone_size(0) == 0:
        return False
    z = 5
    while z <= 11:
        if zone_size(z) == 0:
            return False
        z = z + 1
    z = 5
    while z <= 11 and zone_size(0) > 0:
        top = zone_size(0) - 1
        move_cards(0, top, z)
        flip_card(z, zone_size(z) - 1, True)
        z = z + 1
    return True

def collect_completed_runs():
    z = 5
    while z <= 11:
        sz = zone_size(z)
        if sz >= 13:
            start = sz - 13
            ok = True
            s0 = card_suit(z, start)
            k = 0
            while k < 13:
                idx = start + k
                if not card_face_up(z, idx) or card_suit(z, idx) != s0 or card_rank(z, idx) != 13 - k:
                    ok = False
                k = k + 1
            if ok:
                f = 1
                while f <= 4:
                    if zone_size(f) == 0:
                        move_cards(z, start, f)
                        add_score(100)
                        f = 99
                    f = f + 1
        z = z + 1

def on_turn_end():
    collect_completed_runs()
    z = 5
    while z <= 11:
        sz = zone_size(z)
        if sz > 0 and not card_face_up(z, sz - 1):
            flip_card(z, sz - 1, True)
        z = z + 1
    return True

def get_status():
    f = 1
    done = 0
    while f <= 4:
        if zone_size(f) >= 13:
            done = done + 1
        f = f + 1
    if done == 4:
        return "victory"
    return "playing"
