# --- Cruel Rules (Generic Columns: 0=Stock/Redeal, 1=Waste(unused), 2..5=Foundations, 6..17=12 Piles of 4) ---

def cruel_on_deal():
    # Pre-place all 4 Aces onto Foundations 2..5
    f_zone = 2
    i = zone_size(0) - 1
    while i >= 0 and f_zone <= 5:
        if card_rank(0, i) == 1:
            extract_card(0, i, f_zone)
            flip_card(f_zone, zone_size(f_zone) - 1, True)
            f_zone = f_zone + 1
        i = i - 1

    # Deal remaining 48 cards into 12 tableau piles (6..17), 4 cards each face-up
    z = 6
    while z <= 17 and zone_size(0) > 0:
        k = 0
        while k < 4 and zone_size(0) > 0:
            top = zone_size(0) - 1
            move_cards(0, top, z)
            flip_card(z, zone_size(z) - 1, True)
            k = k + 1
        z = z + 1

    cruel_refresh_badges()
    return True

def cruel_eval():
    score = 0
    z = 2
    while z <= 5:
        score = score + zone_size(z) * 180
        z = z + 1
    z = 6
    while z <= 17:
        sz = zone_size(z)
        i = 0
        while i < sz - 1:
            if card_suit(z, i) == card_suit(z, i + 1) and card_rank(z, i) == card_rank(z, i + 1) + 1:
                score = score + 25
            i = i + 1
        z = z + 1
    return score

def cruel_can_pick(z, i):
    sz = zone_size(z)
    if z < 6 or z > 17 or sz == 0:
        return False
    return i == sz - 1

def cruel_can_drop(from_z, i, to_z):
    if from_z == to_z or from_z < 6 or from_z > 17 or zone_size(from_z) == 0:
        return False
    if i != zone_size(from_z) - 1:
        return False
    r = card_rank(from_z, i)
    s = card_suit(from_z, i)

    if to_z >= 2 and to_z <= 5:
        fsz = zone_size(to_z)
        if fsz == 0:
            return r == 1
        return card_suit(to_z, fsz - 1) == s and r == card_rank(to_z, fsz - 1) + 1

    if to_z >= 6 and to_z <= 17:
        tsz = zone_size(to_z)
        if tsz == 0:
            return False
        return card_suit(to_z, tsz - 1) == s and card_rank(to_z, tsz - 1) == r + 1

    return False

def cruel_would_change():
    last_non_empty = -1
    z = 6
    while z <= 17:
        if zone_size(z) > 0:
            last_non_empty = z
        z = z + 1
    if last_non_empty < 6:
        return False
    z = 6
    while z < last_non_empty:
        if zone_size(z) != 4:
            return True
        z = z + 1
    return zone_size(last_non_empty) > 4

def cruel_refresh_badges():
    if cruel_would_change():
        set_zone_badge(0, "top", "REDEAL OK", True)
    else:
        set_zone_badge(0, "top", "MAKE MOVE", False)
    return True

def cruel_on_turn_end():
    cruel_refresh_badges()
    return True

def cruel_redeal():
    if not cruel_would_change():
        return False

    # Gather from pile 12 (zone 17) down to pile 1 (zone 6), top-to-bottom
    z = 17
    while z >= 6:
        while zone_size(z) > 0:
            top = zone_size(z) - 1
            move_cards(z, top, 0)
        z = z - 1

    if zone_size(0) == 0:
        return False

    # Re-deal in packets of 4 from left to right (zones 6..17)
    z = 6
    while z <= 17 and zone_size(0) > 0:
        k = 0
        while k < 4 and zone_size(0) > 0:
            top = zone_size(0) - 1
            move_cards(0, top, z)
            flip_card(z, zone_size(z) - 1, True)
            k = k + 1
        z = z + 1

    cruel_refresh_badges()
    return True

def cruel_status():
    total = zone_size(2) + zone_size(3) + zone_size(4) + zone_size(5)
    if total == 52:
        return "victory"
    return "playing"

sol.define_game({
    id: "cruel",
