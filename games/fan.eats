    max_redeals: 2,
    prefer_curated_solvable: True,
    demo_seed: 8,
    demo_seeds: [8, 10, 11, 65, 94, 97, 152, 175, 220, 297, 323, 370],
    eval_heuristic: fan_eval,
    can_pick: fan_can_pick,
    can_drop: lbl_can_drop,
    get_status: fan_status,
    doc: {
        meta: [2, "Quick", 3, "Moderate", 4, "Tactical"],
