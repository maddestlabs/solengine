    decks: 1,
    tableaus: 18,
    foundations: 4,
    freecells: 0,
    tableau_deal_counts: [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 1],
    tableau_all_face_up: True,
