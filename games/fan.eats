# =============================================================================
# SolEngine Game Family: Fan (.eats)
# Consolidated variants:
#   - La Belle Lucie
#   - The Fan
# =============================================================================

# --- Shared Parameterized Fan Rules ---

def fan_eval():
    score = 0
    z = 0
    while z <= 3:
        score = score + zone_size(z) * 150
        z = z + 1
    z = 4
    while z <= 21:
        sz = zone_size(z)
        i = 0
        while i < sz - 1:
            if card_suit(z, i) == card_suit(z, i + 1) and card_rank(z, i) == card_rank(z, i + 1) + 1:
                score = score + 20
            i = i + 1
        z = z + 1
    return score

def fan_can_pick(z, i):
    sz = zone_size(z)
    if z < 4 or z > 21 or sz == 0:
        return False
    return i == sz - 1

def fan_can_drop(king_only_empty, from_z, i, to_z):
    if from_z == to_z or zone_size(from_z) == 0:
        return False
    if i != zone_size(from_z) - 1:
        return False
    r = card_rank(from_z, i)
    s = card_suit(from_z, i)

    if to_z >= 0 and to_z <= 3:
        fsz = zone_size(to_z)
        if fsz == 0:
            return r == 1
        return card_suit(to_z, fsz - 1) == s and r == card_rank(to_z, fsz - 1) + 1

    if to_z >= 4 and to_z <= 21:
        tsz = zone_size(to_z)
        if tsz == 0:
            if king_only_empty:
                return r == 13
            return False
        return card_suit(to_z, tsz - 1) == s and card_rank(to_z, tsz - 1) == r + 1

    return False

def fan_status():
    total = zone_size(0) + zone_size(1) + zone_size(2) + zone_size(3)
    if total == 52:
        return "victory"
    return "playing"

def lbl_can_drop(fz, i, tz):
    return fan_can_drop(False, fz, i, tz)

def the_fan_can_drop(fz, i, tz):
    return fan_can_drop(True, fz, i, tz)

