# =============================================================================
# SolEngine Game Family: Scorpion (.eats)
# Consolidated variants:
#   - Scorpion
#   - Wasp
# =============================================================================

# --- Shared Parameterized Scorpion Rules ---

def scorp_eval():
    score = 0
    z = 2
    while z <= 5:
        if zone_size(z) > 0:
            score = score + 1000
        z = z + 1
    z = 6
    while z <= 12:
        sz = zone_size(z)
        i = 0
        while i < sz:
            if not card_face_up(z, i):
                score = score - 20
            elif i < sz - 1 and card_face_up(z, i + 1) and card_suit(z, i) == card_suit(z, i + 1) and card_rank(z, i) == card_rank(z, i + 1) + 1:
                score = score + 30
            i = i + 1
        z = z + 1
    return score

def scorp_on_deal():
    z = 6
    while z <= 12:
        sz = zone_size(z)
        i = 0
        while i < sz:
            if z >= 10 or i >= 3:
                if not card_face_up(z, i):
                    flip_card(z, i, True)
            i = i + 1
        z = z + 1
    return True

def scorp_can_pick(z, i):
    sz = zone_size(z)
    if z < 6 or z > 12 or sz == 0 or i < 0 or i >= sz:
        return False
    return card_face_up(z, i)

def scorp_can_drop(king_only_empty, from_z, i, to_z):
    if from_z == to_z or from_z < 6 or from_z > 12 or to_z < 6 or to_z > 12:
        return False
    if zone_size(from_z) == 0:
        return False
    tsz = zone_size(to_z)
    if tsz == 0:
        if king_only_empty:
            return card_rank(from_z, i) == 13
        return True
    return card_face_up(to_z, tsz - 1) and card_suit(to_z, tsz - 1) == card_suit(from_z, i) and card_rank(to_z, tsz - 1) == card_rank(from_z, i) + 1

def scorp_on_stock():
    if zone_size(0) == 0:
        return False
    z = 6
    while z <= 8 and zone_size(0) > 0:
        top = zone_size(0) - 1
        move_cards(0, top, z)
        flip_card(z, zone_size(z) - 1, True)
        z = z + 1
    return True

def scorp_collect_runs():
    z = 6
    while z <= 12:
        sz = zone_size(z)
        if sz >= 13:
            start = sz - 13
            ok = True
            s0 = card_suit(z, start)
            k = 0
            while k < 13:
                idx = start + k
                if not card_face_up(z, idx) or card_suit(z, idx) != s0 or card_rank(z, idx) != 13 - k:
                    ok = False
                k = k + 1
            if ok:
                f = 2
                while f <= 5:
                    if zone_size(f) == 0:
                        move_cards(z, start, f)
                        add_score(100)
                        f = 99
                    f = f + 1
        z = z + 1

def scorp_on_turn_end():
    scorp_collect_runs()
    z = 6
    while z <= 12:
        sz = zone_size(z)
        if sz > 0 and not card_face_up(z, sz - 1):
            flip_card(z, sz - 1, True)
        z = z + 1
    return True

def scorp_status():
    f = 2
    done = 0
    while f <= 5:
        if zone_size(f) >= 13:
            done = done + 1
        f = f + 1
    if done == 4:
        return "victory"
    return "playing"

def scorpion_drop(fz, i, tz):
    return scorp_can_drop(True, fz, i, tz)

def wasp_drop(fz, i, tz):
    return scorp_can_drop(False, fz, i, tz)

