# =============================================================================
# SolEngine Game Family: Flower Garden (.eats)
# Consolidated variants:
#   - Flower Garden (The Bouquet / Le Parterre)
# References: [Cadogan1870], [MoreheadMottSmith1949], [Parlett1979]
# =============================================================================

# Zone Map:
#   0..15  : The Bouquet (16-card open reserve hand; every card individually playable, no drops back)
#   16..19 : 4 Foundations (Ace to King in suit)
#   20..25 : 6 Flower Beds (6 cards each = 36 cards; build down regardless of suit, single cards)

def fg_layout(bw, bh):
    cw = get_card_width()
    ch = get_card_height()
    top_y = get_safe_top() + 18.0
    left_x = get_safe_left() + 24.0
    right_x = bw - get_safe_right() - 24.0
    usable_w = max(400.0, right_x - left_x)

    # Top row: 4 Foundations centered-right
    f_gap = cw * 1.15
    f_start_x = bw * 0.5 - (f_gap * 3.0 + cw) * 0.5
    f = 0
    while f < 4:
        set_zone_pose(16 + f, f_start_x + f * f_gap, top_y, 0.0, 5)
        f = f + 1

    # Middle row: 6 Flower Beds (fanned vertically downward)
    bed_y = top_y + ch * 1.12
    bed_gap = min(cw * 1.25, (usable_w - cw) / 5.0)
    bed_start_x = bw * 0.5 - (bed_gap * 5.0 + cw) * 0.5
    b = 0
    while b < 6:
        set_zone_pose(20 + b, bed_start_x + b * bed_gap, bed_y, 0.0, 10 + b)
        set_zone_fan(20 + b, 0.0, 1.0)
        set_zone_fan_step(20 + b, ch * 0.20, ch * 0.12)
        b = b + 1

    # Bottom row: 16-card open Bouquet spread cleanly across the lower edge
    bouq_y = max(bed_y + ch * 2.15, bh - get_safe_bottom() - ch - 22.0)
    bouq_step = min(cw * 0.62, (usable_w - cw) / 15.0)
    bouq_start_x = bw * 0.5 - (bouq_step * 15.0 + cw) * 0.5
    k = 0
    while k < 16:
        set_zone_pose(k, bouq_start_x + k * bouq_step, bouq_y, 0.0, 30 + k)
        k = k + 1
    return True

def fg_eval():
    score = 0
    f = 16
    while f <= 19:
        score = score + zone_size(f) * 400
        f = f + 1
    # Keeping cards in the Bouquet is strictly better than burying Flower Beds
    k = 0
    while k <= 15:
        if zone_size(k) > 0:
            score = score + 22
        k = k + 1
    z = 20
    while z <= 25:
        sz = zone_size(z)
        if sz == 0:
            score = score + 90
        else:
            # Penalize burying low cards (Aces..5s) beneath other cards in Flower Beds
            i = 0
            while i < sz:
                r = card_rank(z, i)
                above = (sz - 1) - i
                if r <= 5 and above > 0:
                    score = score - above * (7 - r) * 12
                if i < sz - 1 and r == card_rank(z, i + 1) + 1:
                    score = score + 14
                i = i + 1
        z = z + 1
    return score

def fg_can_pick(z, i):
    sz = zone_size(z)
    if sz == 0 or i != sz - 1:
        return False
    # Any Bouquet card (0..15) or top card of any Flower Bed (20..25)
    if (z >= 0 and z <= 15) or (z >= 20 and z <= 25):
        return True
    return False

def fg_can_drop(from_z, i, to_z):
    if from_z == to_z or zone_size(from_z) == 0:
        return False
    if i != zone_size(from_z) - 1:
        return False
    r = card_rank(from_z, i)
    s = card_suit(from_z, i)

    # Foundations (16..19): Ace to King in suit
    if to_z >= 16 and to_z <= 19:
        fsz = zone_size(to_z)
        if fsz == 0:
            return r == 1
        return card_suit(to_z, fsz - 1) == s and r == card_rank(to_z, fsz - 1) + 1

    # Flower Beds (20..25): build down by rank regardless of suit; any card fills empty bed
    if to_z >= 20 and to_z <= 25:
        tsz = zone_size(to_z)
        if tsz == 0:
            return True
        return card_rank(to_z, tsz - 1) == r + 1

    # Bouquet slots (0..15) cannot receive dropped cards
    return False

def fg_status():
    total = zone_size(16) + zone_size(17) + zone_size(18) + zone_size(19)
    if total == 52:
        return "victory"
    return "playing"

# =============================================================================
# Variant Definitions
# =============================================================================

sol.define_game({
    id: "flower_garden",
    name: "Flower Garden",
    family: "Flower Garden",
    category: "POPULAR",
    mechanic: "building",
    visibility: "open",
    tags: ["classic", "open", "reserve", "bouquet", "single_deck"],
    layout: "columns",
    dynamic_layout: True,
    tableau_build: "any_suit",
    empty_tableau: "any",
    move_group: "single",
    foundation_mode: "suit_up",
    description: "Victorian classic. 6 Flower Beds of 6 cards plus a 16-card open Bouquet where every card is playable at any time.",
    decks: 1,
    tableaus: 6,
    foundations: 4,
    freecells: 16,
    tableau_deal_counts: [6, 6, 6, 6, 6, 6],
    tableau_all_face_up: True,
    foundation_starter_card: False,
    stock_deal_mode: "none",
    stock_deal_count: 0,
    max_redeals: 0,
    # TODO: mine verified solvable demo_seeds
    demo_seed: 35,
    demo_seeds: [35, 57, 58],
    on_layout: fg_layout,
    eval_heuristic: fg_eval,
    can_pick: fg_can_pick,
    can_drop: fg_can_drop,
    get_status: fg_status,
    doc: {
        meta: [3, "Medium", 1, "Pure Skill", 4, "Strategic"],
        aliases: ["The Bouquet", "Le Parterre"],
        goal: ["Build all 4 Foundations up in suit from Ace to King.", "No legal moves remain."],
        zones: [
            { index: 0, name: "The Bouquet (16 Cards)", desc: "16-card open reserve hand; every card is individually playable to Foundations or Flower Beds (cards cannot return to the Bouquet)." },
            { index: 16, name: "Foundations (1-4)", desc: "Build up by same suit from Ace to King.", examples: ["AS", "2S", "3S"] },
            { index: 20, name: "Flower Beds (1-6)", desc: "6 open columns of 6 cards. Build down by rank regardless of suit; single top cards only; any card fills an empty bed." }
        ]
    }
})
