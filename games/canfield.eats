    foundation_mode: "canfield_wrap",
    description: "Famous Saratoga casino classic. 13-card reserve, wrapping alternating cascades, and foundation starter card.",
    decks: 1,
    tableaus: 4,
    foundations: 4,
    freecells: 1,
    tableau_deal_counts: [1, 1, 1, 1],
    tableau_all_face_up: True,
    foundation_starter_card: True,
    stock_deal_mode: "waste_draw_3",
    stock_deal_count: 3,
    max_redeals: -1,
    demo_seed: 19,
    demo_seeds: [19, 22, 33, 58, 64, 106, 113, 301],
    eval_heuristic: canfield_eval,
    on_deal: canfield_on_deal,
    can_pick: canfield_can_pick,
    can_drop: canfield_drop_alt,
    on_stock_click: canfield_stock_3,
    on_turn_end: canfield_on_turn_end,
    get_status: canfield_status,
    doc: {
        meta: [2, "Quick", 4, "High Luck", 3, "Tactical"],
        aliases: ["Demon", "Fascination"],
        goal: ["Build all 4 Foundations up in suit wrapping K->A from the starter rank.", "No legal moves remain."],
        stats: [
            { key: "BASE_RANK", name: "Foundation Base Rank", desc: "Rank of the initial starter card; all 4 Foundations begin on this rank." }
        ],
        zones: [
            { index: 0, name: "Stock", desc: "Click to turn 3 cards into Waste; unlimited redeals." },
            { index: 1, name: "Waste", desc: "Top card may be played to Foundations or Tableau." },
            { index: 2, name: "Foundations (1-4)", desc: "Build up in suit wrapping from King to Ace, starting at BASE_RANK." },
            { index: 6, name: "Reserve (13 Cards)", desc: "Top card is playable; automatically refills empty Tableau columns." },
            { index: 7, name: "Tableau Columns (1-4)", desc: "Build down in alternating colors (wrapping Ace->King); whole columns move together." }
        ]
    }
})

