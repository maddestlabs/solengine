# =============================================================================
# SolEngine Game Family: Canfield (.eats)
# Consolidated variants:
#   - Canfield
#   - Rainbow
# =============================================================================

# --- Shared Parameterized Canfield Rules ---

def canfield_eval():
    score = 0
    z = 2
    while z <= 5:
        score = score + zone_size(z) * 120
        z = z + 1
    return score - zone_size(6) * 30

def canfield_on_deal():
    if zone_size(2) > 0:
        set_stat("BASE_RANK", card_rank(2, 0))
    else:
        set_stat("BASE_RANK", 1)
    return True

def canfield_can_pick(z, i):
    sz = zone_size(z)
    if sz == 0 or i < 0 or i >= sz:
        return False
    if z == 1 or z == 6:
        return i == sz - 1
    if z >= 7 and z <= 10:
        return i == 0 or i == sz - 1
    return False

def canfield_can_drop(alt_color, from_z, i, to_z):
    if from_z == to_z or zone_size(from_z) == 0:
        return False
    sz = zone_size(from_z)
    r = card_rank(from_z, i)
    s = card_suit(from_z, i)
    red = card_is_red(from_z, i)

    if to_z >= 2 and to_z <= 5:
        if i != sz - 1:
            return False
        fsz = zone_size(to_z)
        if fsz == 0:
            return r == get_stat("BASE_RANK", 1)
        top_r = card_rank(to_z, fsz - 1)
        next_r = (top_r % 13) + 1
        return card_suit(to_z, fsz - 1) == s and r == next_r

    if to_z >= 7 and to_z <= 10:
        if from_z >= 7 and from_z <= 10 and i != 0:
            return False
        tsz = zone_size(to_z)
        if tsz == 0:
            if from_z == 6:
                return True
            return zone_size(6) == 0 and (from_z == 1 or (from_z >= 7 and from_z <= 10))
        top_r = card_rank(to_z, tsz - 1)
        next_down = (r % 13) + 1
        if alt_color:
            return (card_is_red(to_z, tsz - 1) != red) and (top_r == next_down)
        return top_r == next_down

    return False

def canfield_stock(draw_count, allow_redeal):
    if zone_size(0) > 0:
        k = 0
        while k < draw_count and zone_size(0) > 0:
            top = zone_size(0) - 1
            move_cards(0, top, 1)
            flip_card(1, zone_size(1) - 1, True)
            k = k + 1
        return True
    if allow_redeal and zone_size(1) > 0:
        while zone_size(1) > 0:
            top = zone_size(1) - 1
            move_cards(1, top, 0)
            flip_card(0, zone_size(0) - 1, False)
        return True
    return False

def canfield_on_turn_end():
    z = 7
    while z <= 10:
        if zone_size(z) == 0 and zone_size(6) > 0:
            top = zone_size(6) - 1
            move_cards(6, top, z)
            flip_card(z, 0, True)
        z = z + 1
    rsz = zone_size(6)
    if rsz > 0 and not card_face_up(6, rsz - 1):
        flip_card(6, rsz - 1, True)
    return True

def canfield_status():
    total = zone_size(2) + zone_size(3) + zone_size(4) + zone_size(5)
    if total == 52:
        return "victory"
    return "playing"

def canfield_drop_alt(fz, i, tz):
    return canfield_can_drop(True, fz, i, tz)

def rainbow_drop_any(fz, i, tz):
    return canfield_can_drop(False, fz, i, tz)

def canfield_stock_3():
    return canfield_stock(3, True)

def rainbow_stock_1():
    return canfield_stock(1, False)

# =============================================================================
# Variant Definitions
# =============================================================================

sol.define_game({
    id: "canfield",
