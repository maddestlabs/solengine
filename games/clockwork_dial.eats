# =============================================================================
# SolEngine Game Variant: Clockwork Dial (.eats)
# =============================================================================
# Radial 12-spoke clock solitaire with outward-fanning rotated cards.

name = "Clockwork Dial"
family = "Golf"
category = "GOLF"
layout = "radial_clock"
description = "12 radial clock spokes fanning outward around a central dial. Play +-1 rank onto the center Foundation."
decks = 1
tableaus = 12
foundations = 1
freecells = 0

tableau_deal_counts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
tableau_all_face_up = False
foundation_starter_card = True

stock_deal_mode = "deal_to_foundation"
stock_deal_count = 1
max_redeals = 0
demo_seed = 2026
demo_seeds = [1, 7, 13, 21, 2026]

# --- Unified Help & Introspection Manifest ---
doc_meta(2, "Quick", 3, "Balanced", 2, "Casual")
doc_aliases(["Radial Clock", "Sun Dial", "Watch"])
doc_goal("Clear all 12 radial clock spokes onto the center Foundation.", "No playable cards remain on the dial and the center Stock is empty.")
doc_zone(0, "Clock Spokes (1-12)", "12 radial piles fanning outward. Play exposed top cards +-1 rank (wrapping K <-> A) to the center Foundation.")
doc_zone(12, "Center Foundation", "Build +-1 in rank regardless of suit.", ["KH", "AS", "2D"])
doc_zone(13, "Center Stock", "Click to deal a fresh card onto the center Foundation.")

def eval_heuristic():
    rem = 0
    z = 0
    while z <= 11:
        rem = rem + zone_size(z)
        z = z + 1
    return (36 - rem) * 100 + zone_size(13) * 15

def on_deal():
    if zone_size(12) == 0 and zone_size(13) > 0:
        move_cards(13, zone_size(13) - 1, 12)
        flip_card(12, 0, True)
    return True

def can_pick(z, i):
    sz = zone_size(z)
    return z >= 0 and z <= 11 and sz > 0 and i == sz - 1 and card_face_up(z, i)

def can_drop(from_z, i, to_z):
    if to_z != 12 or from_z < 0 or from_z > 11:
        return False
    if not can_pick(from_z, i):
        return False
    fsz = zone_size(12)
    if fsz == 0:
        return True
    fr = card_rank(12, fsz - 1)
    mr = card_rank(from_z, i)
    if mr == fr + 1 or mr == fr - 1:
        return True
    if (fr == 13 and mr == 1) or (fr == 1 and mr == 13):
        return True
    return False

def on_card_click(z, i):
    if not can_drop(z, i, 12):
        return False
    move_cards(z, i, 12)
    add_score(10)
    return True

def on_stock_click():
    if zone_size(13) == 0:
        return False
    top = zone_size(13) - 1
    move_cards(13, top, 12)
    flip_card(12, zone_size(12) - 1, True)
    return True

def on_turn_end():
    z = 0
    while z <= 11:
        sz = zone_size(z)
        if sz > 0 and not card_face_up(z, sz - 1):
            flip_card(z, sz - 1, True)
        z = z + 1
    return True

def get_status():
    rem = 0
    z = 0
    while z <= 11:
        rem = rem + zone_size(z)
        z = z + 1
    if rem == 0:
        return "victory"
    return "playing"
