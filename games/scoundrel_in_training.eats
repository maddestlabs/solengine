# =============================================================================
# SolEngine RPG Solitaire: Scoundrel Rookie (.eats)
# =============================================================================
# Approachable 52-card learning variant of Scoundrel.
# Keeps all Red Face Cards (J/Q/K) and Red Aces (11-14 Weapons & Potions)
# while preserving core Scoundrel rules: 1 potion per Room, <= CAP durability,
# barehanded vs. armed combat, Room carryover, and Fleeing.

name = "Scoundrel in Training"
family = "Scoundrel"
category = "RPG"
layout = "columns"
description = "52-card beginner Scoundrel. Includes Red Court weapons & potions (11-14) with standard Scoundrel rules."
decks = 1
tableaus = 4
foundations = 1
freecells = 0
tableau_deal_counts = [1, 1, 1, 1]
tableau_all_face_up = True
foundation_starter_card = False
stock_deal_mode = "none"
stock_deal_count = 1
max_redeals = 0
demo_seed = 17
demo_seeds = [17, 18, 19, 21, 22, 30, 33, 45]

# --- Unified Help & Introspection Manifest ---
doc_meta(1, "Quick", 4, "55%-85%", 2, "Tactical")
doc_aliases(["Scoundrel Easy", "52-Card Scoundrel", "Dungeon Solitaire Easy"])
doc_goal("Clear the entire 52-card Dungeon deck and Room without falling to 0 HP.", "Your HP drops to 0 during combat.")
doc_zone(0, "Dungeon Deck", "Full 52-card deck (includes Red Court Weapons & Potions 11-14). Click when all 4 Room cards are untouched to Flee.", ["AH", "KD"], ["Deals 3 cards when 1 [[Room]] card remains.", "Click with 4 untouched Room cards to [[Flee]] (once per room; not twice in a row)."])
doc_zone(1, "Graveyard", "Slain monsters, consumed potions, and replaced weapons.", [], ["Drag an eligible [[Monster]] here to fight BAREHANDED (preserves weapon [[CAP]])."])
doc_zone(2, "Equipped Weapon", "Active Diamond weapon (2-14).", ["JD", "7D"], ["Equipping a new Diamond replaces your current weapon (discards the old one) and resets [[CAP]].", "Subtracts weapon value from monster value (minimum 0 damage)."])
doc_zone(3, "Room Slot 1", "Active dungeon encounter card.", ["10S", "KH", "QD"], ["Click to resolve (uses Weapon if <= [[CAP]]), or drag a [[Monster]] to [[Graveyard]] to fight barehanded."])
doc_zone(4, "Room Slot 2", "Active dungeon encounter card.", [], ["Resolve 3 of 4 cards; the 4th carries over into the next [[Room]]."])
doc_zone(5, "Room Slot 3", "Active dungeon encounter card.")
doc_zone(6, "Room Slot 4", "Active dungeon encounter card.")
doc_rule("Resolving Monsters", ["Barehanded: Take damage equal to the monster's value (Ace = 14) and discard it to [[Graveyard]].", "With a Weapon: Subtract your weapon's value from the monster's value; take only the difference as damage (minimum 0).", "Drag an eligible [[Monster]] to [[Graveyard]] to fight barehanded instead of using your weapon."])
doc_rule("Weapon Limit (CAP)", ["A fresh [[Weapon]] has no limit and can fight any monster once.", "After killing a monster with a weapon, [[CAP]] drops to that monster's value.", "Subsequent fights with that weapon can only target monsters with value <= [[CAP]] (stronger monsters must be fought barehanded)."])
doc_rule("Weapons & Potions", ["Equipping a new Diamond replaces your current weapon, discarding the old one and resetting [[CAP]].", "[[Potion]] cards (Hearts) heal HP up to 20, but only 1 potion heals per [[Room]]; extra potions are discarded with no effect."])
doc_rule("Fleeing", ["Click [[Dungeon Deck]] when all 4 Room cards are untouched to move them to the bottom and deal 4 new cards. Cannot flee two Rooms in a row."])
doc_stat("HP", "Hit Points", "Starts at 20 (max 20). Reaching 0 ends the run in defeat.")
doc_stat("WEAPON", "Weapon Power", "Attack value of your currently equipped Diamond weapon (2-14).")
doc_stat("CAP", "Weapon Durability Cap", "Maximum monster value your current weapon can still block (<= CAP; 99 when fresh).")
doc_stat("POTION_USED", "Room Potion Limit", "Only 1 Heart potion may heal per Room; extra potions are discarded with no effect.")
doc_stat("FLEE_USED", "Flee Cooldown", "1 if you fled the previous Room (cannot flee two Rooms in a row).")
doc_tag("monster", "Monsters (Spades & Clubs 2-A)", "Value equals rank (Ace = 14). Click to fight with Weapon (if <= [[CAP]]) or barehanded; drag to [[Graveyard]] to force barehanded.")
doc_tag("weapon", "Weapons (Diamonds 2-A)", "Equip to subtract weapon value from monster damage; J=11, Q=12, K=13, A=14. Replaces any existing weapon.")
doc_tag("potion", "Potions (Hearts 2-A)", "Restores HP up to 20 (J=11, Q=12, K=13, A=14; max 1 healing potion per [[Room]]).")

def eval_heuristic():
    hp = get_stat("HP", 20)
    wpn = get_stat("WEAPON", 0)
    cap = get_stat("CAP", 99)
    eff_cap = cap
    if cap >= 99:
        eff_cap = 14
    flee = get_stat("FLEE_USED", 0)
    remaining = zone_size(0) + room_card_count()
    return hp * 70 + wpn * 35 + eff_cap * 30 - remaining * 180 - flee * 40

def card_power(z, i):
    r = card_rank(z, i)
    if r == 1:
        return 14
    return r

def tag_card_rpg(z, i):
    s = card_suit(z, i)
    p = card_power(z, i)
    if s == 0 or s == 3:
        set_card_stat(z, i, "attack", p)
        add_card_tag(z, i, "monster")
    elif s == 2:
        set_card_stat(z, i, "attack", p)
        add_card_tag(z, i, "weapon")
    else:
        set_card_stat(z, i, "hp", p)
        add_card_tag(z, i, "potion")

def room_card_count():
    cnt = 0
    z = 3
    while z <= 6:
        if zone_size(z) > 0:
            cnt = cnt + 1
        z = z + 1
    return cnt

def deal_empty_room_slots():
    z = 3
    while z <= 6:
        if zone_size(z) == 0 and zone_size(0) > 0:
            top = zone_size(0) - 1
            move_cards(0, top, z)
            flip_card(z, 0, True)
            tag_card_rpg(z, 0)
        z = z + 1

def refill_room():
    deal_empty_room_slots()
    set_stat("POTION_USED", 0)
    set_stat("FLEE_USED", 0)

def resolve_potion(z, i):
    p = card_power(z, i)
    if get_stat("POTION_USED", 0) == 0:
        hp = get_stat("HP", 20)
        new_hp = hp + p
        if new_hp > 20:
            new_hp = 20
        set_stat("HP", new_hp)
        set_stat("POTION_USED", 1)
        add_score(p * 10)
    move_cards(z, i, 1)
    return True

def resolve_weapon(z, i):
    p = card_power(z, i)
    if zone_size(2) > 0:
        move_cards(2, 0, 1)
    move_cards(z, i, 2)
    set_stat("WEAPON", p)
    set_stat("CAP", 99)
    set_card_stat(2, 0, "durability", 99)
    add_score(p * 5)
    return True

def resolve_monster(z, i, use_weapon):
    p = card_power(z, i)
    hp = get_stat("HP", 20)
    wpn = get_stat("WEAPON", 0)
    cap = get_stat("CAP", 99)
    dmg = p
    if use_weapon and wpn > 0 and p <= cap:
        dmg = p - wpn
        if dmg < 0:
            dmg = 0
        set_stat("CAP", p)
        if zone_size(2) > 0:
            set_card_stat(2, 0, "durability", p)

    new_hp = hp - dmg
    if new_hp < 0:
        new_hp = 0
    set_stat("HP", new_hp)
    move_cards(z, i, 1)
    add_score(p * 15)
    return True

def on_deal():
    set_stat("HP", 20)
    set_stat("WEAPON", 0)
    set_stat("CAP", 99)
    set_stat("POTION_USED", 0)
    set_stat("FLEE_USED", 0)
    z = 3
    while z <= 6:
        if zone_size(z) > 0:
            tag_card_rpg(z, 0)
        z = z + 1
    return True

def can_pick(z, i):
    return z >= 3 and z <= 6 and card_face_up(z, i)

def can_drop(from_z, i, to_z):
    if from_z < 3 or from_z > 6:
        return False
    if not card_face_up(from_z, i):
        return False
    if to_z == 1:
        s = card_suit(from_z, i)
        if s == 0 or s == 3:
            wpn = get_stat("WEAPON", 0)
            cap = get_stat("CAP", 99)
            return wpn > 0 and card_power(from_z, i) <= cap
    return False

def on_drop(from_z, i, to_z):
    if not can_drop(from_z, i, to_z):
        return False
    return resolve_monster(from_z, i, False)

def on_card_click(z, i):
    if z < 3 or z > 6:
        return False
    if zone_size(z) == 0:
        return False
    s = card_suit(z, i)
    if s == 1:
        return resolve_potion(z, i)
    if s == 2:
        return resolve_weapon(z, i)
    return resolve_monster(z, i, True)

def on_stock_click():
    if zone_size(0) == 0:
        return False
    cnt = room_card_count()
    if cnt == 4:
        if get_stat("FLEE_USED", 0) != 0:
            return False
        z = 3
        while z <= 6:
            if zone_size(z) > 0:
                flip_card(z, 0, False)
                move_cards_bottom(z, 0, 0)
            z = z + 1
        deal_empty_room_slots()
        set_stat("POTION_USED", 0)
        set_stat("FLEE_USED", 1)
        return True
    if cnt <= 1:
        refill_room()
        return True
    return False

def on_turn_end():
    if room_card_count() <= 1 and zone_size(0) > 0:
        refill_room()
    return True

def get_status():
    if get_stat("HP", 20) <= 0:
        return "defeat"
    if zone_size(0) == 0 and room_card_count() == 0:
        return "victory"
    return "playing"
