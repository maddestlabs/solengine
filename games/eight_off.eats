# =============================================================================
# SolEngine Game Variant: Eight Off (.eats)
# =============================================================================
# Classic 8-cell FreeCell variant. 8 columns of 6 cards; 4 cards start in cells.
# Tableau builds down in same suit; Kings only may fill empty columns.

name = "Eight Off"
family = "FreeCell"
category = "FREECELL"
layout = "columns"
description = "8 FreeCells (4 pre-filled). Build down in the SAME SUIT; only Kings may fill empty columns."
decks = 1
tableaus = 8
foundations = 4
freecells = 8

tableau_deal_counts = [6, 6, 6, 6, 6, 6, 6, 6]
tableau_all_face_up = True
foundation_starter_card = False

stock_deal_mode = "none"
stock_deal_count = 0
max_redeals = 0
demo_seed = 2

# --- Unified Help & Introspection Manifest ---
doc_meta(3, "Medium", 1, "Pure Skill", 4, "Tactical")
doc_aliases(["Eight Cells"])
doc_goal("Build all 4 Foundations up in suit from Ace to King.", "No legal moves remain.")
doc_zone(0, "FreeCells (1-8)", "8 temporary single-card cells; 4 start occupied.", [], ["Each cell holds 1 card."])
doc_zone(8, "Foundations (1-4)", "Build up by same suit from Ace to King.", ["AS", "2S", "3S"])
doc_zone(12, "Tableau Columns (1-8)", "Build down in the SAME SUIT; only Kings fill empty columns.", ["KS", "QS", "JS"])

def eval_heuristic():
    score = 0
    z = 8
    while z <= 11:
        score = score + zone_size(z) * 150
        z = z + 1
    z = 0
    while z <= 7:
        if zone_size(z) == 0:
            score = score + 20
        z = z + 1
    z = 12
    while z <= 19:
        sz = zone_size(z)
        if sz == 0:
            score = score + 20
        else:
            i = 0
            while i < sz - 1:
                if card_suit(z, i) == card_suit(z, i + 1) and card_rank(z, i) == card_rank(z, i + 1) + 1:
                    score = score + 25
                i = i + 1
        z = z + 1
    return score

def can_pick(z, i):
    sz = zone_size(z)
    if sz == 0 or i < 0 or i >= sz:
        return False
    if z >= 0 and z <= 7:
        return i == sz - 1
    if z >= 12 and z <= 19:
        if i == sz - 1:
            return True
        k = i
        while k < sz - 1:
            if card_suit(z, k) != card_suit(z, k + 1) or card_rank(z, k) != card_rank(z, k + 1) + 1:
                return False
            k = k + 1
        empty_fc = 0
        f = 0
        while f <= 7:
            if zone_size(f) == 0:
                empty_fc = empty_fc + 1
            f = f + 1
        return (sz - i) <= (empty_fc + 1)
    return False

def can_drop(from_z, i, to_z):
    if from_z == to_z or zone_size(from_z) == 0:
        return False
    sz = zone_size(from_z)
    r = card_rank(from_z, i)
    s = card_suit(from_z, i)

    if to_z >= 0 and to_z <= 7:
        return i == sz - 1 and zone_size(to_z) == 0

    if to_z >= 8 and to_z <= 11:
        if i != sz - 1:
            return False
        fsz = zone_size(to_z)
        if fsz == 0:
            return r == 1
        return card_suit(to_z, fsz - 1) == s and r == card_rank(to_z, fsz - 1) + 1

    if to_z >= 12 and to_z <= 19:
        tsz = zone_size(to_z)
        if tsz == 0:
            return r == 13
        return (card_suit(to_z, tsz - 1) == s) and (card_rank(to_z, tsz - 1) == r + 1)

    return False

def get_status():
    total = zone_size(8) + zone_size(9) + zone_size(10) + zone_size(11)
    if total == 52:
        return "victory"
    return "playing"
